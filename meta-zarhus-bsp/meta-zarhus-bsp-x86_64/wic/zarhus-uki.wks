bootloader --timeout=0 --ptable gpt

part /boot --source bootimg-partition --fstype=vfat --label zarhus-boot --align 2048 --uuid ${BOOT_UUID} --active --use-uuid --part-type C12A7328-F81F-11D2-BA4B-00A0C93EC93B
part / --source rootfs --fstype=ext4 --label rootfs --align 2048 --uuid ${ROOT_UUID} --use-uuid --part-type C12A7328-F81F-11D2-BA4B-00A0C93EC93B
