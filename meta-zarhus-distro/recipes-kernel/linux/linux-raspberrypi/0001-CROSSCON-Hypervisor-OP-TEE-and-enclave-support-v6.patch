+/*
+ * 6. Driver initialization
+ *
+ * During driver initialization is secure world probed to find out which
+ * features it supports so the driver can be initialized with a matching
+ * configuration. This involves for instance support for dynamic shared
+ * memory instead of a static memory carvout.
+ */
+
+static void optee2_get_version(struct tee_device *teedev,
+			      struct tee_ioctl_version_data *vers)
+{
+	struct tee_ioctl_version_data v = {
+		.impl_id = TEE_IMPL_ID_OPTEE2,
+		.impl_caps = TEE_OPTEE_CAP_TZ,
+		.gen_caps = TEE_GEN_CAP_GP,
+	};
+	struct optee2 *optee2 = tee_get_drvdata(teedev);
+
+	if (optee2->smc.sec_caps & OPTEE2_SMC_SEC_CAP_DYNAMIC_SHM)
+		v.gen_caps |= TEE_GEN_CAP_REG_MEM;
+	if (optee2->smc.sec_caps & OPTEE2_SMC_SEC_CAP_MEMREF_NULL)
+		v.gen_caps |= TEE_GEN_CAP_MEMREF_NULL;
+	*vers = v;
+}
+
+static int optee2_smc_open(struct tee_context *ctx)
+{
+	struct optee2 *optee2 = tee_get_drvdata(ctx->teedev);
+	u32 sec_caps = optee2->smc.sec_caps;
+
+	return optee2_open(ctx, sec_caps & OPTEE2_SMC_SEC_CAP_MEMREF_NULL);
+}
