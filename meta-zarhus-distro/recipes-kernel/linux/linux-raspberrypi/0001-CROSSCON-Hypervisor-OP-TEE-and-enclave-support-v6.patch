+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/crash_dump.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/tee_drv.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+#include "optee2_private.h"
+
+int optee2_pool_op_alloc_helper(struct tee_shm_pool *pool, struct tee_shm *shm,
+			       size_t size, size_t align,
+			       int (*shm_register)(struct tee_context *ctx,
+						   struct tee_shm *shm,
+						   struct page **pages,
+						   size_t num_pages,
+						   unsigned long start))
+{
+	unsigned int order = get_order(size);
+	struct page *page;
+	int rc = 0;
+
+	/*
+	 * Ignore alignment since this is already going to be page aligned
+	 * and there's no need for any larger alignment.
+	 */
+	page = alloc_pages(GFP_KERNEL | __GFP_ZERO, order);
+	if (!page)
+		return -ENOMEM;
+
+	shm->kaddr = page_address(page);
+	shm->paddr = page_to_phys(page);
+	shm->size = PAGE_SIZE << order;
+
+	if (shm_register) {
+		unsigned int nr_pages = 1 << order, i;
+		struct page **pages;
+
+		pages = kcalloc(nr_pages, sizeof(*pages), GFP_KERNEL);
+		if (!pages) {
+			rc = -ENOMEM;
+			goto err;
+		}
+
+		for (i = 0; i < nr_pages; i++)
+			pages[i] = page + i;
+
+		rc = shm_register(shm->ctx, shm, pages, nr_pages,
+				  (unsigned long)shm->kaddr);
+		kfree(pages);
+		if (rc)
+			goto err;
+	}
+
+	return 0;
+
+err:
+	free_pages((unsigned long)shm->kaddr, order);
+	return rc;
+}
+
+void optee2_pool_op_free_helper(struct tee_shm_pool *pool, struct tee_shm *shm,
+			       int (*shm_unregister)(struct tee_context *ctx,
+						     struct tee_shm *shm))
+{
+	if (shm_unregister)
+		shm_unregister(shm->ctx, shm);
+	free_pages((unsigned long)shm->kaddr, get_order(shm->size));
+	shm->kaddr = NULL;
+}
+
+static void optee2_bus_scan(struct work_struct *work)
+{
+	WARN_ON(optee2_enumerate_devices(PTA_CMD_GET_DEVICES_SUPP));
+}
+
+int optee2_open(struct tee_context *ctx, bool cap_memref_null)
+{
+	struct optee2_context_data *ctxdata;
+	struct tee_device *teedev = ctx->teedev;
+	struct optee2 *optee2 = tee_get_drvdata(teedev);
+
+	ctxdata = kzalloc(sizeof(*ctxdata), GFP_KERNEL);
+	if (!ctxdata)
+		return -ENOMEM;
+
+	if (teedev == optee2->supp_teedev) {
+		bool busy = true;
+
+		mutex_lock(&optee2->supp.mutex);
+		if (!optee2->supp.ctx) {
+			busy = false;
+			optee2->supp.ctx = ctx;
+		}
+		mutex_unlock(&optee2->supp.mutex);
+		if (busy) {
+			kfree(ctxdata);
+			return -EBUSY;
+		}
+
+		if (!optee2->scan_bus_done) {
+			INIT_WORK(&optee2->scan_bus_work, optee2_bus_scan);
+			optee2->scan_bus_wq = create_workqueue("optee2_bus_scan");
+			if (!optee2->scan_bus_wq) {
+				kfree(ctxdata);
+				return -ECHILD;
+			}
+			queue_work(optee2->scan_bus_wq, &optee2->scan_bus_work);
+			optee2->scan_bus_done = true;
+		}
+	}
+	mutex_init(&ctxdata->mutex);
+	INIT_LIST_HEAD(&ctxdata->sess_list);
+
+	ctx->cap_memref_null = cap_memref_null;
+	ctx->data = ctxdata;
+	return 0;
+}
+
+static void optee2_release_helper(struct tee_context *ctx,
+				 int (*close_session)(struct tee_context *ctx,
+						      u32 session))
+{
+	struct optee2_context_data *ctxdata = ctx->data;
+	struct optee2_session *sess;
+	struct optee2_session *sess_tmp;
+
+	if (!ctxdata)
+		return;
+
+	list_for_each_entry_safe(sess, sess_tmp, &ctxdata->sess_list,
+				 list_node) {
+		list_del(&sess->list_node);
+		close_session(ctx, sess->session_id);
+		kfree(sess);
+	}
+	kfree(ctxdata);
+	ctx->data = NULL;
+}
+
+void optee2_release(struct tee_context *ctx)
+{
+	optee2_release_helper(ctx, optee2_close_session_helper);
+}
+
+void optee2_release_supp(struct tee_context *ctx)
+{
+	struct optee2 *optee2 = tee_get_drvdata(ctx->teedev);
+
+	optee2_release_helper(ctx, optee2_close_session_helper);
+	if (optee2->scan_bus_wq) {
+		destroy_workqueue(optee2->scan_bus_wq);
+		optee2->scan_bus_wq = NULL;
+	}
+	optee2_supp_release(&optee2->supp);
+}
+
+void optee2_remove_common(struct optee2 *optee2)
+{
+	/* Unregister OP-TEE specific client devices on TEE bus */
+	optee2_unregister_devices();
+
+	optee2_notif_uninit(optee2);
+	optee2_shm_arg_cache_uninit(optee2);
+	teedev_close_context(optee2->ctx);
+	/*
+	 * The two devices have to be unregistered before we can free the
+	 * other resources.
+	 */
+	tee_device_unregister(optee2->supp_teedev);
+	tee_device_unregister(optee2->teedev);
+
+	tee_shm_pool_free(optee2->pool);
+	optee2_supp_uninit(&optee2->supp);
+	mutex_destroy(&optee2->call_queue.mutex);
+}
+
+static int smc_abi_rc;
+static int ffa_abi_rc;
+
+static int __init optee2_core_init(void)
+{
+	/*
+	 * The kernel may have crashed at the same time that all available
+	 * secure world threads were suspended and we cannot reschedule the
+	 * suspended threads without access to the crashed kernel's wait_queue.
+	 * Therefore, we cannot reliably initialize the OP-TEE driver in the
+	 * kdump kernel.
+	 */
+	if (is_kdump_kernel())
+		return -ENODEV;
+
+	smc_abi_rc = optee2_smc_abi_register();
+	ffa_abi_rc = optee2_ffa_abi_register();
+
+	/* If both failed there's no point with this module */
+	if (smc_abi_rc && ffa_abi_rc)
+		return smc_abi_rc;
+	return 0;
+}
+module_init(optee2_core_init);
+
+static void __exit optee2_core_exit(void)
+{
+	if (!smc_abi_rc)
+		optee2_smc_abi_unregister();
+	if (!ffa_abi_rc)
+		optee2_ffa_abi_unregister();
+}
+module_exit(optee2_core_exit);
+
+MODULE_AUTHOR("Linaro");
+MODULE_DESCRIPTION("OP-TEE driver");
+MODULE_VERSION("1.0");
+MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:optee2");
diff --git a/drivers/tee/optee2/device.c b/drivers/tee/optee2/device.c
new file mode 100644
index 000000000000..322f8bd442c7
--- /dev/null
+++ b/drivers/tee/optee2/device.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2019 Linaro Ltd.
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/tee_drv.h>
+#include <linux/uuid.h>
+#include "optee2_private.h"
+
+static int optee2_ctx_match(struct tee_ioctl_version_data *ver, const void *data)
+{
+	if (ver->impl_id == TEE_IMPL_ID_OPTEE2)
+		return 1;
+	else
+		return 0;
+}
+
+static int get_devices(struct tee_context *ctx, u32 session,
+		       struct tee_shm *device_shm, u32 *shm_size,
+		       u32 func)
+{
+	int ret = 0;
+	struct tee_ioctl_invoke_arg inv_arg;
+	struct tee_param param[4];
+
+	memset(&inv_arg, 0, sizeof(inv_arg));
+	memset(&param, 0, sizeof(param));
+
+	inv_arg.func = func;
+	inv_arg.session = session;
+	inv_arg.num_params = 4;
+
+	/* Fill invoke cmd params */
+	param[0].attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_OUTPUT;
+	param[0].u.memref.shm = device_shm;
+	param[0].u.memref.size = *shm_size;
+	param[0].u.memref.shm_offs = 0;
+
+	ret = tee_client_invoke_func(ctx, &inv_arg, param);
+	if ((ret < 0) || ((inv_arg.ret != TEEC_SUCCESS) &&
+			  (inv_arg.ret != TEEC_ERROR_SHORT_BUFFER))) {
+		pr_err("PTA_CMD_GET_DEVICES invoke function err: %x\n",
+		       inv_arg.ret);
+		return -EINVAL;
+	}
+
+	*shm_size = param[0].u.memref.size;
+
+	return 0;
+}
+
+static void optee2_release_device(struct device *dev)
+{
+	struct tee_client_device *optee2_device = to_tee_client_device(dev);
+
+	kfree(optee2_device);
+}
+
+static ssize_t need_supplicant_show(struct device *dev,
+				    struct device_attribute *attr,
+				    char *buf)
+{
+	return 0;
+}
+
+static DEVICE_ATTR_RO(need_supplicant);
+
+static int optee2_register_device(const uuid_t *device_uuid, u32 func)
+{
+	struct tee_client_device *optee2_device = NULL;
+	int rc;
+
+	optee2_device = kzalloc(sizeof(*optee2_device), GFP_KERNEL);
+	if (!optee2_device)
+		return -ENOMEM;
+
+	optee2_device->dev.bus = &tee_bus_type;
+	optee2_device->dev.release = optee2_release_device;
+	if (dev_set_name(&optee2_device->dev, "optee2-ta-%pUb", device_uuid)) {
+		kfree(optee2_device);
+		return -ENOMEM;
+	}
+	uuid_copy(&optee2_device->id.uuid, device_uuid);
+
+	rc = device_register(&optee2_device->dev);
+	if (rc) {
+		pr_err("device registration failed, err: %d\n", rc);
+		put_device(&optee2_device->dev);
+		return rc;
+	}
+
+	if (func == PTA_CMD_GET_DEVICES_SUPP)
+		device_create_file(&optee2_device->dev,
+				   &dev_attr_need_supplicant);
+
+	return 0;
+}
+
+static int __optee2_enumerate_devices(u32 func)
+{
+	const uuid_t pta_uuid =
+		UUID_INIT(0x7011a688, 0xddde, 0x4053,
+			  0xa5, 0xa9, 0x7b, 0x3c, 0x4d, 0xdf, 0x13, 0xb8);
+	struct tee_ioctl_open_session_arg sess_arg;
+	struct tee_shm *device_shm = NULL;
+	const uuid_t *device_uuid = NULL;
+	struct tee_context *ctx = NULL;
+	u32 shm_size = 0, idx, num_devices = 0;
+	int rc;
+
+	memset(&sess_arg, 0, sizeof(sess_arg));
+
+	/* Open context with OP-TEE driver */
+	ctx = tee_client_open_context(NULL, optee2_ctx_match, NULL, NULL);
+	if (IS_ERR(ctx))
+		return -ENODEV;
+
+	/* Open session with device enumeration pseudo TA */
+	export_uuid(sess_arg.uuid, &pta_uuid);
+	sess_arg.clnt_login = TEE_IOCTL_LOGIN_PUBLIC;
+	sess_arg.num_params = 0;
+
+	rc = tee_client_open_session(ctx, &sess_arg, NULL);
+	if ((rc < 0) || (sess_arg.ret != TEEC_SUCCESS)) {
+		/* Device enumeration pseudo TA not found */
+		rc = 0;
+		goto out_ctx;
+	}
+
+	rc = get_devices(ctx, sess_arg.session, NULL, &shm_size, func);
+	if (rc < 0 || !shm_size)
+		goto out_sess;
+
+	device_shm = tee_shm_alloc_kernel_buf(ctx, shm_size);
+	if (IS_ERR(device_shm)) {
+		pr_err("tee_shm_alloc_kernel_buf failed\n");
+		rc = PTR_ERR(device_shm);
+		goto out_sess;
+	}
+
+	rc = get_devices(ctx, sess_arg.session, device_shm, &shm_size, func);
+	if (rc < 0)
+		goto out_shm;
+
+	device_uuid = tee_shm_get_va(device_shm, 0);
+	if (IS_ERR(device_uuid)) {
+		pr_err("tee_shm_get_va failed\n");
+		rc = PTR_ERR(device_uuid);
+		goto out_shm;
+	}
+
+	num_devices = shm_size / sizeof(uuid_t);
+
+	for (idx = 0; idx < num_devices; idx++) {
+		rc = optee2_register_device(&device_uuid[idx], func);
+		if (rc)
+			goto out_shm;
+	}
+
+out_shm:
+	tee_shm_free(device_shm);
+out_sess:
+	tee_client_close_session(ctx, sess_arg.session);
+out_ctx:
+	tee_client_close_context(ctx);
+
+	return rc;
+}
+
+int optee2_enumerate_devices(u32 func)
+{
+	return  __optee2_enumerate_devices(func);
+}
+
+static int __optee2_unregister_device(struct device *dev, void *data)
+{
+	if (!strncmp(dev_name(dev), "optee2-ta", strlen("optee2-ta")))
+		device_unregister(dev);
+
+	return 0;
+}
+
+void optee2_unregister_devices(void)
+{
+	bus_for_each_dev(&tee_bus_type, NULL, NULL,
+			 __optee2_unregister_device);
+}
diff --git a/drivers/tee/optee2/ffa_abi.c b/drivers/tee/optee2/ffa_abi.c
new file mode 100644
index 000000000000..9ac39b794435
--- /dev/null
+++ b/drivers/tee/optee2/ffa_abi.c
@@ -0,0 +1,928 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2021, Linaro Limited
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/arm_ffa.h>
+#include <linux/errno.h>
+#include <linux/scatterlist.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/tee_drv.h>
+#include <linux/types.h>
+#include "optee2_private.h"
+#include "optee2_ffa.h"
+#include "optee2_rpc_cmd.h"
+
+/*
+ * This file implement the FF-A ABI used when communicating with secure world
+ * OP-TEE OS via FF-A.
+ * This file is divided into the following sections:
+ * 1. Maintain a hash table for lookup of a global FF-A memory handle
+ * 2. Convert between struct tee_param and struct optee2_msg_param
+ * 3. Low level support functions to register shared memory in secure world
+ * 4. Dynamic shared memory pool based on alloc_pages()
+ * 5. Do a normal scheduled call into secure world
+ * 6. Driver initialization.
+ */
+
+/*
+ * 1. Maintain a hash table for lookup of a global FF-A memory handle
+ *
+ * FF-A assigns a global memory handle for each piece shared memory.
+ * This handle is then used when communicating with secure world.
+ *
+ * Main functions are optee2_shm_add_ffa_handle() and optee2_shm_rem_ffa_handle()
+ */
+struct shm_rhash {
+	struct tee_shm *shm;
+	u64 global_id;
+	struct rhash_head linkage;
+};
+
+static void rh_free_fn(void *ptr, void *arg)
+{
+	kfree(ptr);
+}
+
+static const struct rhashtable_params shm_rhash_params = {
+	.head_offset = offsetof(struct shm_rhash, linkage),
+	.key_len     = sizeof(u64),
+	.key_offset  = offsetof(struct shm_rhash, global_id),
+	.automatic_shrinking = true,
+};
+
+static struct tee_shm *optee2_shm_from_ffa_handle(struct optee2 *optee2,
+						 u64 global_id)
+{
+	struct tee_shm *shm = NULL;
+	struct shm_rhash *r;
+
+	mutex_lock(&optee2->ffa.mutex);
+	r = rhashtable_lookup_fast(&optee2->ffa.global_ids, &global_id,
+				   shm_rhash_params);
+	if (r)
+		shm = r->shm;
+	mutex_unlock(&optee2->ffa.mutex);
+
+	return shm;
+}
+
+static int optee2_shm_add_ffa_handle(struct optee2 *optee2, struct tee_shm *shm,
+				    u64 global_id)
+{
+	struct shm_rhash *r;
+	int rc;
+
+	r = kmalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return -ENOMEM;
+	r->shm = shm;
+	r->global_id = global_id;
+
+	mutex_lock(&optee2->ffa.mutex);
+	rc = rhashtable_lookup_insert_fast(&optee2->ffa.global_ids, &r->linkage,
+					   shm_rhash_params);
+	mutex_unlock(&optee2->ffa.mutex);
+
+	if (rc)
+		kfree(r);
+
+	return rc;
+}
+
+static int optee2_shm_rem_ffa_handle(struct optee2 *optee2, u64 global_id)
+{
+	struct shm_rhash *r;
+	int rc = -ENOENT;
+
+	mutex_lock(&optee2->ffa.mutex);
+	r = rhashtable_lookup_fast(&optee2->ffa.global_ids, &global_id,
+				   shm_rhash_params);
+	if (r)
+		rc = rhashtable_remove_fast(&optee2->ffa.global_ids,
+					    &r->linkage, shm_rhash_params);
+	mutex_unlock(&optee2->ffa.mutex);
+
+	if (!rc)
+		kfree(r);
+
+	return rc;
+}
+
+/*
+ * 2. Convert between struct tee_param and struct optee2_msg_param
+ *
+ * optee2_ffa_from_msg_param() and optee2_ffa_to_msg_param() are the main
+ * functions.
+ */
+
+static void from_msg_param_ffa_mem(struct optee2 *optee2, struct tee_param *p,
+				   u32 attr, const struct optee2_msg_param *mp)
+{
+	struct tee_shm *shm = NULL;
+	u64 offs_high = 0;
+	u64 offs_low = 0;
+
+	p->attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT +
+		  attr - OPTEE2_MSG_ATTR_TYPE_FMEM_INPUT;
+	p->u.memref.size = mp->u.fmem.size;
+
+	if (mp->u.fmem.global_id != OPTEE2_MSG_FMEM_INVALID_GLOBAL_ID)
+		shm = optee2_shm_from_ffa_handle(optee2, mp->u.fmem.global_id);
+	p->u.memref.shm = shm;
+
+	if (shm) {
+		offs_low = mp->u.fmem.offs_low;
+		offs_high = mp->u.fmem.offs_high;
+	}
+	p->u.memref.shm_offs = offs_low | offs_high << 32;
+}
+
+/**
+ * optee2_ffa_from_msg_param() - convert from OPTEE2_MSG parameters to
+ *				struct tee_param
+ * @optee2:	main service struct
+ * @params:	subsystem internal parameter representation
+ * @num_params:	number of elements in the parameter arrays
+ * @msg_params:	OPTEE2_MSG parameters
+ *
+ * Returns 0 on success or <0 on failure
+ */
+static int optee2_ffa_from_msg_param(struct optee2 *optee2,
+				    struct tee_param *params, size_t num_params,
+				    const struct optee2_msg_param *msg_params)
+{
+	size_t n;
+
+	for (n = 0; n < num_params; n++) {
+		struct tee_param *p = params + n;
+		const struct optee2_msg_param *mp = msg_params + n;
+		u32 attr = mp->attr & OPTEE2_MSG_ATTR_TYPE_MASK;
+
+		switch (attr) {
+		case OPTEE2_MSG_ATTR_TYPE_NONE:
+			p->attr = TEE_IOCTL_PARAM_ATTR_TYPE_NONE;
+			memset(&p->u, 0, sizeof(p->u));
+			break;
+		case OPTEE2_MSG_ATTR_TYPE_VALUE_INPUT:
+		case OPTEE2_MSG_ATTR_TYPE_VALUE_OUTPUT:
+		case OPTEE2_MSG_ATTR_TYPE_VALUE_INOUT:
+			optee2_from_msg_param_value(p, attr, mp);
+			break;
+		case OPTEE2_MSG_ATTR_TYPE_FMEM_INPUT:
+		case OPTEE2_MSG_ATTR_TYPE_FMEM_OUTPUT:
+		case OPTEE2_MSG_ATTR_TYPE_FMEM_INOUT:
+			from_msg_param_ffa_mem(optee2, p, attr, mp);
+			break;
+		default:
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+static int to_msg_param_ffa_mem(struct optee2_msg_param *mp,
+				const struct tee_param *p)
+{
+	struct tee_shm *shm = p->u.memref.shm;
+
+	mp->attr = OPTEE2_MSG_ATTR_TYPE_FMEM_INPUT + p->attr -
+		   TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT;
+
+	if (shm) {
+		u64 shm_offs = p->u.memref.shm_offs;
+
+		mp->u.fmem.internal_offs = shm->offset;
+
+		mp->u.fmem.offs_low = shm_offs;
+		mp->u.fmem.offs_high = shm_offs >> 32;
+		/* Check that the entire offset could be stored. */
+		if (mp->u.fmem.offs_high != shm_offs >> 32)
+			return -EINVAL;
+
+		mp->u.fmem.global_id = shm->sec_world_id;
+	} else {
+		memset(&mp->u, 0, sizeof(mp->u));
+		mp->u.fmem.global_id = OPTEE2_MSG_FMEM_INVALID_GLOBAL_ID;
+	}
+	mp->u.fmem.size = p->u.memref.size;
+
+	return 0;
+}
+
+/**
+ * optee2_ffa_to_msg_param() - convert from struct tee_params to OPTEE2_MSG
+ *			      parameters
+ * @optee2:	main service struct
+ * @msg_params:	OPTEE2_MSG parameters
+ * @num_params:	number of elements in the parameter arrays
+ * @params:	subsystem itnernal parameter representation
+ * Returns 0 on success or <0 on failure
+ */
+static int optee2_ffa_to_msg_param(struct optee2 *optee2,
+				  struct optee2_msg_param *msg_params,
+				  size_t num_params,
+				  const struct tee_param *params)
+{
+	size_t n;
+
+	for (n = 0; n < num_params; n++) {
+		const struct tee_param *p = params + n;
+		struct optee2_msg_param *mp = msg_params + n;
+
+		switch (p->attr) {
+		case TEE_IOCTL_PARAM_ATTR_TYPE_NONE:
+			mp->attr = TEE_IOCTL_PARAM_ATTR_TYPE_NONE;
+			memset(&mp->u, 0, sizeof(mp->u));
+			break;
+		case TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT:
+		case TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_OUTPUT:
+		case TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INOUT:
+			optee2_to_msg_param_value(mp, p);
+			break;
+		case TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT:
+		case TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_OUTPUT:
+		case TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INOUT:
+			if (to_msg_param_ffa_mem(mp, p))
+				return -EINVAL;
+			break;
+		default:
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * 3. Low level support functions to register shared memory in secure world
+ *
+ * Functions to register and unregister shared memory both for normal
+ * clients and for tee-supplicant.
+ */
+
+static int optee2_ffa_shm_register(struct tee_context *ctx, struct tee_shm *shm,
+				  struct page **pages, size_t num_pages,
+				  unsigned long start)
+{
+	struct optee2 *optee2 = tee_get_drvdata(ctx->teedev);
+	struct ffa_device *ffa_dev = optee2->ffa.ffa_dev;
+	const struct ffa_mem_ops *mem_ops = ffa_dev->ops->mem_ops;
+	struct ffa_mem_region_attributes mem_attr = {
+		.receiver = ffa_dev->vm_id,
+		.attrs = FFA_MEM_RW,
+	};
+	struct ffa_mem_ops_args args = {
+		.use_txbuf = true,
+		.attrs = &mem_attr,
+		.nattrs = 1,
+	};
+	struct sg_table sgt;
+	int rc;
+
+	rc = optee2_check_mem_type(start, num_pages);
+	if (rc)
+		return rc;
+
+	rc = sg_alloc_table_from_pages(&sgt, pages, num_pages, 0,
+				       num_pages * PAGE_SIZE, GFP_KERNEL);
+	if (rc)
+		return rc;
+	args.sg = sgt.sgl;
+	rc = mem_ops->memory_share(&args);
+	sg_free_table(&sgt);
+	if (rc)
+		return rc;
+
+	rc = optee2_shm_add_ffa_handle(optee2, shm, args.g_handle);
+	if (rc) {
+		mem_ops->memory_reclaim(args.g_handle, 0);
+		return rc;
+	}
+
+	shm->sec_world_id = args.g_handle;
+
+	return 0;
+}
+
+static int optee2_ffa_shm_unregister(struct tee_context *ctx,
+				    struct tee_shm *shm)
+{
+	struct optee2 *optee2 = tee_get_drvdata(ctx->teedev);
+	struct ffa_device *ffa_dev = optee2->ffa.ffa_dev;
+	const struct ffa_msg_ops *msg_ops = ffa_dev->ops->msg_ops;
+	const struct ffa_mem_ops *mem_ops = ffa_dev->ops->mem_ops;
+	u64 global_handle = shm->sec_world_id;
+	struct ffa_send_direct_data data = {
+		.data0 = OPTEE2_FFA_UNREGISTER_SHM,
+		.data1 = (u32)global_handle,
+		.data2 = (u32)(global_handle >> 32)
+	};
+	int rc;
+
+	optee2_shm_rem_ffa_handle(optee2, global_handle);
+	shm->sec_world_id = 0;
+
+	rc = msg_ops->sync_send_receive(ffa_dev, &data);
+	if (rc)
+		pr_err("Unregister SHM id 0x%llx rc %d\n", global_handle, rc);
+
+	rc = mem_ops->memory_reclaim(global_handle, 0);
+	if (rc)
+		pr_err("mem_reclaim: 0x%llx %d", global_handle, rc);
+
+	return rc;
+}
+
+static int optee2_ffa_shm_unregister_supp(struct tee_context *ctx,
+					 struct tee_shm *shm)
+{
+	struct optee2 *optee2 = tee_get_drvdata(ctx->teedev);
+	const struct ffa_mem_ops *mem_ops;
+	u64 global_handle = shm->sec_world_id;
+	int rc;
+
+	/*
+	 * We're skipping the OPTEE2_FFA_YIELDING_CALL_UNREGISTER_SHM call
+	 * since this is OP-TEE freeing via RPC so it has already retired
+	 * this ID.
+	 */
+
+	optee2_shm_rem_ffa_handle(optee2, global_handle);
+	mem_ops = optee2->ffa.ffa_dev->ops->mem_ops;
+	rc = mem_ops->memory_reclaim(global_handle, 0);
+	if (rc)
+		pr_err("mem_reclaim: 0x%llx %d", global_handle, rc);
+
+	shm->sec_world_id = 0;
+
+	return rc;
+}
+
+/*
+ * 4. Dynamic shared memory pool based on alloc_pages()
+ *
+ * Implements an OP-TEE specific shared memory pool.
+ * The main function is optee2_ffa_shm_pool_alloc_pages().
+ */
+
+static int pool_ffa_op_alloc(struct tee_shm_pool *pool,
+			     struct tee_shm *shm, size_t size, size_t align)
+{
+	return optee2_pool_op_alloc_helper(pool, shm, size, align,
+					  optee2_ffa_shm_register);
+}
+
+static void pool_ffa_op_free(struct tee_shm_pool *pool,
+			     struct tee_shm *shm)
+{
+	optee2_pool_op_free_helper(pool, shm, optee2_ffa_shm_unregister);
+}
+
+static void pool_ffa_op_destroy_pool(struct tee_shm_pool *pool)
+{
+	kfree(pool);
+}
+
+static const struct tee_shm_pool_ops pool_ffa_ops = {
+	.alloc = pool_ffa_op_alloc,
+	.free = pool_ffa_op_free,
+	.destroy_pool = pool_ffa_op_destroy_pool,
+};
+
+/**
+ * optee2_ffa_shm_pool_alloc_pages() - create page-based allocator pool
+ *
+ * This pool is used with OP-TEE over FF-A. In this case command buffers
+ * and such are allocated from kernel's own memory.
+ */
+static struct tee_shm_pool *optee2_ffa_shm_pool_alloc_pages(void)
+{
+	struct tee_shm_pool *pool = kzalloc(sizeof(*pool), GFP_KERNEL);
+
+	if (!pool)
+		return ERR_PTR(-ENOMEM);
+
+	pool->ops = &pool_ffa_ops;
+
+	return pool;
+}
+
+/*
+ * 5. Do a normal scheduled call into secure world
+ *
+ * The function optee2_ffa_do_call_with_arg() performs a normal scheduled
+ * call into secure world. During this call may normal world request help
+ * from normal world using RPCs, Remote Procedure Calls. This includes
+ * delivery of non-secure interrupts to for instance allow rescheduling of
+ * the current task.
+ */
+
+static void handle_ffa_rpc_func_cmd_shm_alloc(struct tee_context *ctx,
+					      struct optee2 *optee2,
+					      struct optee2_msg_arg *arg)
+{
+	struct tee_shm *shm;
+
+	if (arg->num_params != 1 ||
+	    arg->params[0].attr != OPTEE2_MSG_ATTR_TYPE_VALUE_INPUT) {
+		arg->ret = TEEC_ERROR_BAD_PARAMETERS;
+		return;
+	}
+
+	switch (arg->params[0].u.value.a) {
+	case OPTEE2_RPC_SHM_TYPE_APPL:
+		shm = optee2_rpc_cmd_alloc_suppl(ctx, arg->params[0].u.value.b);
+		break;
+	case OPTEE2_RPC_SHM_TYPE_KERNEL:
+		shm = tee_shm_alloc_priv_buf(optee2->ctx,
+					     arg->params[0].u.value.b);
+		break;
+	default:
+		arg->ret = TEEC_ERROR_BAD_PARAMETERS;
+		return;
+	}
+
+	if (IS_ERR(shm)) {
+		arg->ret = TEEC_ERROR_OUT_OF_MEMORY;
+		return;
+	}
+
+	arg->params[0] = (struct optee2_msg_param){
+		.attr = OPTEE2_MSG_ATTR_TYPE_FMEM_OUTPUT,
+		.u.fmem.size = tee_shm_get_size(shm),
+		.u.fmem.global_id = shm->sec_world_id,
+		.u.fmem.internal_offs = shm->offset,
+	};
+
+	arg->ret = TEEC_SUCCESS;
+}
+
+static void handle_ffa_rpc_func_cmd_shm_free(struct tee_context *ctx,
+					     struct optee2 *optee2,
+					     struct optee2_msg_arg *arg)
+{
+	struct tee_shm *shm;
+
+	if (arg->num_params != 1 ||
+	    arg->params[0].attr != OPTEE2_MSG_ATTR_TYPE_VALUE_INPUT)
+		goto err_bad_param;
+
+	shm = optee2_shm_from_ffa_handle(optee2, arg->params[0].u.value.b);
+	if (!shm)
+		goto err_bad_param;
+	switch (arg->params[0].u.value.a) {
+	case OPTEE2_RPC_SHM_TYPE_APPL:
+		optee2_rpc_cmd_free_suppl(ctx, shm);
+		break;
+	case OPTEE2_RPC_SHM_TYPE_KERNEL:
+		tee_shm_free(shm);
+		break;
+	default:
+		goto err_bad_param;
+	}
+	arg->ret = TEEC_SUCCESS;
+	return;
+
+err_bad_param:
+	arg->ret = TEEC_ERROR_BAD_PARAMETERS;
+}
+
+static void handle_ffa_rpc_func_cmd(struct tee_context *ctx,
+				    struct optee2 *optee2,
+				    struct optee2_msg_arg *arg)
+{
+	arg->ret_origin = TEEC_ORIGIN_COMMS;
+	switch (arg->cmd) {
+	case OPTEE2_RPC_CMD_SHM_ALLOC:
+		handle_ffa_rpc_func_cmd_shm_alloc(ctx, optee2, arg);
+		break;
+	case OPTEE2_RPC_CMD_SHM_FREE:
+		handle_ffa_rpc_func_cmd_shm_free(ctx, optee2, arg);
+		break;
+	default:
+		optee2_rpc_cmd(ctx, optee2, arg);
+	}
+}
+
+static void optee2_handle_ffa_rpc(struct tee_context *ctx, struct optee2 *optee2,
+				 u32 cmd, struct optee2_msg_arg *arg)
+{
+	switch (cmd) {
+	case OPTEE2_FFA_YIELDING_CALL_RETURN_RPC_CMD:
+		handle_ffa_rpc_func_cmd(ctx, optee2, arg);
+		break;
+	case OPTEE2_FFA_YIELDING_CALL_RETURN_INTERRUPT:
+		/* Interrupt delivered by now */
+		break;
+	default:
+		pr_warn("Unknown RPC func 0x%x\n", cmd);
+		break;
+	}
+}
+
+static int optee2_ffa_yielding_call(struct tee_context *ctx,
+				   struct ffa_send_direct_data *data,
+				   struct optee2_msg_arg *rpc_arg)
+{
+	struct optee2 *optee2 = tee_get_drvdata(ctx->teedev);
+	struct ffa_device *ffa_dev = optee2->ffa.ffa_dev;
+	const struct ffa_msg_ops *msg_ops = ffa_dev->ops->msg_ops;
+	struct optee2_call_waiter w;
+	u32 cmd = data->data0;
+	u32 w4 = data->data1;
+	u32 w5 = data->data2;
+	u32 w6 = data->data3;
+	int rc;
+
+	/* Initialize waiter */
+	optee2_cq_wait_init(&optee2->call_queue, &w);
+	while (true) {
+		rc = msg_ops->sync_send_receive(ffa_dev, data);
+		if (rc)
+			goto done;
+
+		switch ((int)data->data0) {
+		case TEEC_SUCCESS:
+			break;
+		case TEEC_ERROR_BUSY:
+			if (cmd == OPTEE2_FFA_YIELDING_CALL_RESUME) {
+				rc = -EIO;
+				goto done;
+			}
+
+			/*
+			 * Out of threads in secure world, wait for a thread
+			 * become available.
+			 */
+			optee2_cq_wait_for_completion(&optee2->call_queue, &w);
+			data->data0 = cmd;
+			data->data1 = w4;
+			data->data2 = w5;
+			data->data3 = w6;
+			continue;
+		default:
+			rc = -EIO;
+			goto done;
+		}
+
+		if (data->data1 == OPTEE2_FFA_YIELDING_CALL_RETURN_DONE)
+			goto done;
+
+		/*
+		 * OP-TEE has returned with a RPC request.
+		 *
+		 * Note that data->data4 (passed in register w7) is already
+		 * filled in by ffa_mem_ops->sync_send_receive() returning
+		 * above.
+		 */
+		cond_resched();
+		optee2_handle_ffa_rpc(ctx, optee2, data->data1, rpc_arg);
+		cmd = OPTEE2_FFA_YIELDING_CALL_RESUME;
+		data->data0 = cmd;
+		data->data1 = 0;
+		data->data2 = 0;
+		data->data3 = 0;
+	}
+done:
+	/*
+	 * We're done with our thread in secure world, if there's any
+	 * thread waiters wake up one.
+	 */
+	optee2_cq_wait_final(&optee2->call_queue, &w);
+
+	return rc;
+}
+
+/**
+ * optee2_ffa_do_call_with_arg() - Do a FF-A call to enter OP-TEE in secure world
+ * @ctx:	calling context
+ * @shm:	shared memory holding the message to pass to secure world
+ * @offs:	offset of the message in @shm
+ *
+ * Does a FF-A call to OP-TEE in secure world and handles eventual resulting
+ * Remote Procedure Calls (RPC) from OP-TEE.
+ *
+ * Returns return code from FF-A, 0 is OK
+ */
+
+static int optee2_ffa_do_call_with_arg(struct tee_context *ctx,
+				      struct tee_shm *shm, u_int offs)
+{
+	struct ffa_send_direct_data data = {
+		.data0 = OPTEE2_FFA_YIELDING_CALL_WITH_ARG,
+		.data1 = (u32)shm->sec_world_id,
+		.data2 = (u32)(shm->sec_world_id >> 32),
+		.data3 = offs,
+	};
+	struct optee2_msg_arg *arg;
+	unsigned int rpc_arg_offs;
+	struct optee2_msg_arg *rpc_arg;
+
+	/*
+	 * The shared memory object has to start on a page when passed as
+	 * an argument struct. This is also what the shm pool allocator
+	 * returns, but check this before calling secure world to catch
+	 * eventual errors early in case something changes.
+	 */
+	if (shm->offset)
+		return -EINVAL;
+
+	arg = tee_shm_get_va(shm, offs);
+	if (IS_ERR(arg))
+		return PTR_ERR(arg);
+
+	rpc_arg_offs = OPTEE2_MSG_GET_ARG_SIZE(arg->num_params);
+	rpc_arg = tee_shm_get_va(shm, offs + rpc_arg_offs);
+	if (IS_ERR(rpc_arg))
+		return PTR_ERR(rpc_arg);
+
+	return optee2_ffa_yielding_call(ctx, &data, rpc_arg);
+}
+
+/*
+ * 6. Driver initialization
+ *
+ * During driver inititialization is the OP-TEE Secure Partition is probed
+ * to find out which features it supports so the driver can be initialized
+ * with a matching configuration.
+ */
+
+static bool optee2_ffa_api_is_compatbile(struct ffa_device *ffa_dev,
+					const struct ffa_ops *ops)
+{
+	const struct ffa_msg_ops *msg_ops = ops->msg_ops;
+	struct ffa_send_direct_data data = {
+		.data0 = OPTEE2_FFA_GET_API_VERSION,
+	};
+	int rc;
+
+	msg_ops->mode_32bit_set(ffa_dev);
+
+	rc = msg_ops->sync_send_receive(ffa_dev, &data);
+	if (rc) {
+		pr_err("Unexpected error %d\n", rc);
+		return false;
+	}
+	if (data.data0 != OPTEE2_FFA_VERSION_MAJOR ||
+	    data.data1 < OPTEE2_FFA_VERSION_MINOR) {
+		pr_err("Incompatible OP-TEE API version %lu.%lu",
+		       data.data0, data.data1);
+		return false;
+	}
+
+	data = (struct ffa_send_direct_data){
+		.data0 = OPTEE2_FFA_GET_OS_VERSION,
+	};
+	rc = msg_ops->sync_send_receive(ffa_dev, &data);
+	if (rc) {
+		pr_err("Unexpected error %d\n", rc);
+		return false;
+	}
+	if (data.data2)
+		pr_info("revision %lu.%lu (%08lx)",
+			data.data0, data.data1, data.data2);
+	else
+		pr_info("revision %lu.%lu", data.data0, data.data1);
+
+	return true;
+}
+
+static bool optee2_ffa_exchange_caps(struct ffa_device *ffa_dev,
+				    const struct ffa_ops *ops,
+				    u32 *sec_caps,
+				    unsigned int *rpc_param_count)
+{
+	struct ffa_send_direct_data data = {
+		.data0 = OPTEE2_FFA_EXCHANGE_CAPABILITIES,
+	};
+	int rc;
+
+	rc = ops->msg_ops->sync_send_receive(ffa_dev, &data);
+	if (rc) {
+		pr_err("Unexpected error %d", rc);
+		return false;
+	}
+	if (data.data0) {
+		pr_err("Unexpected exchange error %lu", data.data0);
+		return false;
+	}
+
+	*rpc_param_count = (u8)data.data1;
+	*sec_caps = data.data2;
+
+	return true;
+}
+
+static void optee2_ffa_get_version(struct tee_device *teedev,
+				  struct tee_ioctl_version_data *vers)
+{
+	struct tee_ioctl_version_data v = {
+		.impl_id = TEE_IMPL_ID_OPTEE2,
+		.impl_caps = TEE_OPTEE_CAP_TZ,
+		.gen_caps = TEE_GEN_CAP_GP | TEE_GEN_CAP_REG_MEM |
+			    TEE_GEN_CAP_MEMREF_NULL,
+	};
+
+	*vers = v;
+}
+
+static int optee2_ffa_open(struct tee_context *ctx)
+{
+	return optee2_open(ctx, true);
+}
+
+static const struct tee_driver_ops optee2_ffa_clnt_ops = {
+	.get_version = optee2_ffa_get_version,
+	.open = optee2_ffa_open,
+	.release = optee2_release,
+	.open_session = optee2_open_session,
+	.close_session = optee2_close_session,
+	.invoke_func = optee2_invoke_func,
+	.cancel_req = optee2_cancel_req,
+	.shm_register = optee2_ffa_shm_register,
+	.shm_unregister = optee2_ffa_shm_unregister,
+};
+
+static const struct tee_desc optee2_ffa_clnt_desc = {
+	.name = DRIVER_NAME "-ffa-clnt",
+	.ops = &optee2_ffa_clnt_ops,
+	.owner = THIS_MODULE,
+};
+
+static const struct tee_driver_ops optee2_ffa_supp_ops = {
+	.get_version = optee2_ffa_get_version,
+	.open = optee2_ffa_open,
+	.release = optee2_release_supp,
+	.supp_recv = optee2_supp_recv,
+	.supp_send = optee2_supp_send,
+	.shm_register = optee2_ffa_shm_register, /* same as for clnt ops */
+	.shm_unregister = optee2_ffa_shm_unregister_supp,
+};
+
+static const struct tee_desc optee2_ffa_supp_desc = {
+	.name = DRIVER_NAME "-ffa-supp",
+	.ops = &optee2_ffa_supp_ops,
+	.owner = THIS_MODULE,
+	.flags = TEE_DESC_PRIVILEGED,
+};
+
+static const struct optee2_ops optee2_ffa_ops = {
+	.do_call_with_arg = optee2_ffa_do_call_with_arg,
+	.to_msg_param = optee2_ffa_to_msg_param,
+	.from_msg_param = optee2_ffa_from_msg_param,
+};
+
+static void optee2_ffa_remove(struct ffa_device *ffa_dev)
+{
+	struct optee2 *optee2 = ffa_dev_get_drvdata(ffa_dev);
+
+	optee2_remove_common(optee2);
+
+	mutex_destroy(&optee2->ffa.mutex);
+	rhashtable_free_and_destroy(&optee2->ffa.global_ids, rh_free_fn, NULL);
+
+	kfree(optee2);
+}
+
+static int optee2_ffa_probe(struct ffa_device *ffa_dev)
+{
+	const struct ffa_ops *ffa_ops;
+	unsigned int rpc_param_count;
+	struct tee_shm_pool *pool;
+	struct tee_device *teedev;
+	struct tee_context *ctx;
+	u32 arg_cache_flags = 0;
+	struct optee2 *optee2;
+	u32 sec_caps;
+	int rc;
+
+	ffa_ops = ffa_dev->ops;
+
+	if (!optee2_ffa_api_is_compatbile(ffa_dev, ffa_ops))
+		return -EINVAL;
+
+	if (!optee2_ffa_exchange_caps(ffa_dev, ffa_ops, &sec_caps,
+				     &rpc_param_count))
+		return -EINVAL;
+	if (sec_caps & OPTEE2_FFA_SEC_CAP_ARG_OFFSET)
+		arg_cache_flags |= OPTEE2_SHM_ARG_SHARED;
+
+	optee2 = kzalloc(sizeof(*optee2), GFP_KERNEL);
+	if (!optee2)
+		return -ENOMEM;
+
+	pool = optee2_ffa_shm_pool_alloc_pages();
+	if (IS_ERR(pool)) {
+		rc = PTR_ERR(pool);
+		goto err_free_optee2;
+	}
+	optee2->pool = pool;
+
+	optee2->ops = &optee2_ffa_ops;
+	optee2->ffa.ffa_dev = ffa_dev;
+	optee2->rpc_param_count = rpc_param_count;
+
+	teedev = tee_device_alloc(&optee2_ffa_clnt_desc, NULL, optee2->pool,
+				  optee2);
+	if (IS_ERR(teedev)) {
+		rc = PTR_ERR(teedev);
+		goto err_free_pool;
+	}
+	optee2->teedev = teedev;
+
+	teedev = tee_device_alloc(&optee2_ffa_supp_desc, NULL, optee2->pool,
+				  optee2);
+	if (IS_ERR(teedev)) {
+		rc = PTR_ERR(teedev);
+		goto err_unreg_teedev;
+	}
+	optee2->supp_teedev = teedev;
+
+	rc = tee_device_register(optee2->teedev);
+	if (rc)
+		goto err_unreg_supp_teedev;
+
+	rc = tee_device_register(optee2->supp_teedev);
+	if (rc)
+		goto err_unreg_supp_teedev;
+
+	rc = rhashtable_init(&optee2->ffa.global_ids, &shm_rhash_params);
+	if (rc)
+		goto err_unreg_supp_teedev;
+	mutex_init(&optee2->ffa.mutex);
+	mutex_init(&optee2->call_queue.mutex);
+	INIT_LIST_HEAD(&optee2->call_queue.waiters);
+	optee2_supp_init(&optee2->supp);
+	optee2_shm_arg_cache_init(optee2, arg_cache_flags);
+	ffa_dev_set_drvdata(ffa_dev, optee2);
+	ctx = teedev_open(optee2->teedev);
+	if (IS_ERR(ctx)) {
+		rc = PTR_ERR(ctx);
+		goto err_rhashtable_free;
+	}
+	optee2->ctx = ctx;
+	rc = optee2_notif_init(optee2, OPTEE2_DEFAULT_MAX_NOTIF_VALUE);
+	if (rc)
+		goto err_close_ctx;
+
+	rc = optee2_enumerate_devices(PTA_CMD_GET_DEVICES);
+	if (rc)
+		goto err_unregister_devices;
+
+	pr_info("initialized driver\n");
+	return 0;
+
+err_unregister_devices:
+	optee2_unregister_devices();
+	optee2_notif_uninit(optee2);
+err_close_ctx:
+	teedev_close_context(ctx);
+err_rhashtable_free:
+	rhashtable_free_and_destroy(&optee2->ffa.global_ids, rh_free_fn, NULL);
+	optee2_supp_uninit(&optee2->supp);
+	mutex_destroy(&optee2->call_queue.mutex);
+	mutex_destroy(&optee2->ffa.mutex);
+err_unreg_supp_teedev:
+	tee_device_unregister(optee2->supp_teedev);
+err_unreg_teedev:
+	tee_device_unregister(optee2->teedev);
+err_free_pool:
+	tee_shm_pool_free(pool);
+err_free_optee2:
+	kfree(optee2);
+	return rc;
+}
+
+static const struct ffa_device_id optee2_ffa_device_id[] = {
+	/* 486178e0-e7f8-11e3-bc5e0002a5d5c51b */
+	{ UUID_INIT(0x486178e0, 0xe7f8, 0x11e3,
+		    0xbc, 0x5e, 0x00, 0x02, 0xa5, 0xd5, 0xc5, 0x1b) },
+	{}
+};
+
+static struct ffa_driver optee2_ffa_driver = {
+	.name = "optee2",
+	.probe = optee2_ffa_probe,
+	.remove = optee2_ffa_remove,
+	.id_table = optee2_ffa_device_id,
+};
+
+int optee2_ffa_abi_register(void)
+{
+	if (IS_REACHABLE(CONFIG_ARM_FFA_TRANSPORT))
+		return ffa_register(&optee2_ffa_driver);
+	else
+		return -EOPNOTSUPP;
+}
+
+void optee2_ffa_abi_unregister(void)
+{
+	if (IS_REACHABLE(CONFIG_ARM_FFA_TRANSPORT))
+		ffa_unregister(&optee2_ffa_driver);
+}
diff --git a/drivers/tee/optee2/notif.c b/drivers/tee/optee2/notif.c
new file mode 100644
index 000000000000..5ccff7eaa242
--- /dev/null
+++ b/drivers/tee/optee2/notif.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2015-2021, Linaro Limited
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/arm-smccc.h>
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/tee_drv.h>
+#include "optee2_private.h"
+
+struct notif_entry {
+	struct list_head link;
+	struct completion c;
+	u_int key;
+};
+
+static bool have_key(struct optee2 *optee2, u_int key)
+{
+	struct notif_entry *entry;
+
+	list_for_each_entry(entry, &optee2->notif.db, link)
+		if (entry->key == key)
+			return true;
+
+	return false;
+}
+
+int optee2_notif_wait(struct optee2 *optee2, u_int key)
+{
+	unsigned long flags;
+	struct notif_entry *entry;
+	int rc = 0;
+
+	if (key > optee2->notif.max_key)
+		return -EINVAL;
+
+	entry = kmalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+	init_completion(&entry->c);
+	entry->key = key;
+
+	spin_lock_irqsave(&optee2->notif.lock, flags);
+
+	/*
+	 * If the bit is already set it means that the key has already
+	 * been posted and we must not wait.
+	 */
+	if (test_bit(key, optee2->notif.bitmap)) {
+		clear_bit(key, optee2->notif.bitmap);
+		goto out;
+	}
+
+	/*
+	 * Check if someone is already waiting for this key. If there is
+	 * it's a programming error.
+	 */
+	if (have_key(optee2, key)) {
+		rc = -EBUSY;
+		goto out;
+	}
+
+	list_add_tail(&entry->link, &optee2->notif.db);
+
+	/*
+	 * Unlock temporarily and wait for completion.
+	 */
+	spin_unlock_irqrestore(&optee2->notif.lock, flags);
+	wait_for_completion(&entry->c);
+	spin_lock_irqsave(&optee2->notif.lock, flags);
+
+	list_del(&entry->link);
+out:
+	spin_unlock_irqrestore(&optee2->notif.lock, flags);
+
+	kfree(entry);
+
+	return rc;
+}
+
+int optee2_notif_send(struct optee2 *optee2, u_int key)
+{
+	unsigned long flags;
+	struct notif_entry *entry;
+
+	if (key > optee2->notif.max_key)
+		return -EINVAL;
+
+	spin_lock_irqsave(&optee2->notif.lock, flags);
+
+	list_for_each_entry(entry, &optee2->notif.db, link)
+		if (entry->key == key) {
+			complete(&entry->c);
+			goto out;
+		}
+
+	/* Only set the bit in case there where nobody waiting */
+	set_bit(key, optee2->notif.bitmap);
+out:
+	spin_unlock_irqrestore(&optee2->notif.lock, flags);
+
+	return 0;
+}
+
+int optee2_notif_init(struct optee2 *optee2, u_int max_key)
+{
+	spin_lock_init(&optee2->notif.lock);
+	INIT_LIST_HEAD(&optee2->notif.db);
+	optee2->notif.bitmap = bitmap_zalloc(max_key, GFP_KERNEL);
+	if (!optee2->notif.bitmap)
+		return -ENOMEM;
+
+	optee2->notif.max_key = max_key;
+
+	return 0;
+}
+
+void optee2_notif_uninit(struct optee2 *optee2)
+{
+	bitmap_free(optee2->notif.bitmap);
+}
diff --git a/drivers/tee/optee2/optee2_ffa.h b/drivers/tee/optee2/optee2_ffa.h
new file mode 100644
index 000000000000..cc67a3264557
--- /dev/null
+++ b/drivers/tee/optee2/optee2_ffa.h
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (c) 2019-2021, Linaro Limited
+ */
+
+/*
+ * This file is exported by OP-TEE and is kept in sync between secure world
+ * and normal world drivers. We're using ARM FF-A 1.0 specification.
+ */
+
+#ifndef __OPTEE2_FFA_H
+#define __OPTEE2_FFA_H
+
+#include <linux/arm_ffa.h>
+
+/*
+ * Normal world sends requests with FFA_MSG_SEND_DIRECT_REQ and
+ * responses are returned with FFA_MSG_SEND_DIRECT_RESP for normal
+ * messages.
+ *
+ * All requests with FFA_MSG_SEND_DIRECT_REQ and FFA_MSG_SEND_DIRECT_RESP
+ * are using the AArch32 SMC calling convention with register usage as
+ * defined in FF-A specification:
+ * w0:    Function ID (0x8400006F or 0x84000070)
+ * w1:    Source/Destination IDs
+ * w2:    Reserved (MBZ)
+ * w3-w7: Implementation defined, free to be used below
+ */
+
+#define OPTEE2_FFA_VERSION_MAJOR	1
+#define OPTEE2_FFA_VERSION_MINOR	0
+
+#define OPTEE2_FFA_BLOCKING_CALL(id)	(id)
+#define OPTEE2_FFA_YIELDING_CALL_BIT	31
+#define OPTEE2_FFA_YIELDING_CALL(id)	((id) | BIT(OPTEE2_FFA_YIELDING_CALL_BIT))
+
+/*
+ * Returns the API version implemented, currently follows the FF-A version.
+ * Call register usage:
+ * w3:    Service ID, OPTEE2_FFA_GET_API_VERSION
+ * w4-w7: Not used (MBZ)
+ *
+ * Return register usage:
+ * w3:    OPTEE2_FFA_VERSION_MAJOR
+ * w4:    OPTEE2_FFA_VERSION_MINOR
+ * w5-w7: Not used (MBZ)
+ */
+#define OPTEE2_FFA_GET_API_VERSION	OPTEE2_FFA_BLOCKING_CALL(0)
+
+/*
+ * Returns the revision of OP-TEE.
+ *
+ * Used by non-secure world to figure out which version of the Trusted OS
+ * is installed. Note that the returned revision is the revision of the
+ * Trusted OS, not of the API.
+ *
+ * Call register usage:
+ * w3:    Service ID, OPTEE2_FFA_GET_OS_VERSION
+ * w4-w7: Unused (MBZ)
+ *
+ * Return register usage:
+ * w3:    CFG_OPTEE2_REVISION_MAJOR
+ * w4:    CFG_OPTEE2_REVISION_MINOR
+ * w5:    TEE_IMPL_GIT_SHA1 (or zero if not supported)
+ */
+#define OPTEE2_FFA_GET_OS_VERSION	OPTEE2_FFA_BLOCKING_CALL(1)
+
+/*
+ * Exchange capabilities between normal world and secure world.
+ *
+ * Currently there are no defined capabilities. When features are added new
+ * capabilities may be added.
+ *
+ * Call register usage:
+ * w3:    Service ID, OPTEE2_FFA_EXCHANGE_CAPABILITIES
+ * w4-w7: Note used (MBZ)
+ *
+ * Return register usage:
+ * w3:    Error code, 0 on success
+ * w4:    Bit[7:0]:  Number of parameters needed for RPC to be supplied
+ *                   as the second MSG arg struct for
+ *                   OPTEE2_FFA_YIELDING_CALL_WITH_ARG.
+ *        Bit[31:8]: Reserved (MBZ)
+ * w5:	  Bitfield of secure world capabilities OPTEE2_FFA_SEC_CAP_* below,
+ *	  unused bits MBZ.
+ * w6-w7: Not used (MBZ)
+ */
+/*
+ * Secure world supports giving an offset into the argument shared memory
+ * object, see also OPTEE2_FFA_YIELDING_CALL_WITH_ARG
+ */
+#define OPTEE2_FFA_SEC_CAP_ARG_OFFSET	BIT(0)
+
+#define OPTEE2_FFA_EXCHANGE_CAPABILITIES OPTEE2_FFA_BLOCKING_CALL(2)
+
+/*
+ * Unregister shared memory
+ *
+ * Call register usage:
+ * w3:    Service ID, OPTEE2_FFA_YIELDING_CALL_UNREGISTER_SHM
+ * w4:    Shared memory handle, lower bits
+ * w5:    Shared memory handle, higher bits
+ * w6-w7: Not used (MBZ)
+ *
+ * Return register usage:
+ * w3:    Error code, 0 on success
+ * w4-w7: Note used (MBZ)
+ */
+#define OPTEE2_FFA_UNREGISTER_SHM	OPTEE2_FFA_BLOCKING_CALL(3)
+
+/*
+ * Call with struct optee2_msg_arg as argument in the supplied shared memory
+ * with a zero internal offset and normal cached memory attributes.
+ * Register usage:
+ * w3:    Service ID, OPTEE2_FFA_YIELDING_CALL_WITH_ARG
+ * w4:    Lower 32 bits of a 64-bit Shared memory handle
+ * w5:    Upper 32 bits of a 64-bit Shared memory handle
+ * w6:    Offset into shared memory pointing to a struct optee2_msg_arg
+ *	  right after the parameters of this struct (at offset
+ *	  OPTEE2_MSG_GET_ARG_SIZE(num_params) follows a struct optee2_msg_arg
+ *	  for RPC, this struct has reserved space for the number of RPC
+ *	  parameters as returned by OPTEE2_FFA_EXCHANGE_CAPABILITIES.
+ *	  MBZ unless the bit OPTEE2_FFA_SEC_CAP_ARG_OFFSET is received with
+ *	  OPTEE2_FFA_EXCHANGE_CAPABILITIES.
+ * w7:    Not used (MBZ)
+ * Resume from RPC. Register usage:
+ * w3:    Service ID, OPTEE2_FFA_YIELDING_CALL_RESUME
+ * w4-w6: Not used (MBZ)
+ * w7:    Resume info
+ *
+ * Normal return (yielding call is completed). Register usage:
+ * w3:    Error code, 0 on success
+ * w4:    OPTEE2_FFA_YIELDING_CALL_RETURN_DONE
+ * w5-w7: Not used (MBZ)
+ *
+ * RPC interrupt return (RPC from secure world). Register usage:
+ * w3:    Error code == 0
+ * w4:    Any defined RPC code but OPTEE2_FFA_YIELDING_CALL_RETURN_DONE
+ * w5-w6: Not used (MBZ)
+ * w7:    Resume info
+ *
+ * Possible error codes in register w3:
+ * 0:                       Success
+ * FFA_DENIED:              w4 isn't one of OPTEE2_FFA_YIELDING_CALL_START
+ *                          OPTEE2_FFA_YIELDING_CALL_RESUME
+ *
+ * Possible error codes for OPTEE2_FFA_YIELDING_CALL_START,
+ * FFA_BUSY:               Number of OP-TEE OS threads exceeded,
+ *                         try again later
+ * FFA_DENIED:             RPC shared memory object not found
+ * FFA_INVALID_PARAMETER:  Bad shared memory handle or offset into the memory
+ *
+ * Possible error codes for OPTEE2_FFA_YIELDING_CALL_RESUME
+ * FFA_INVALID_PARAMETER:  Bad resume info
+ */
+#define OPTEE2_FFA_YIELDING_CALL_WITH_ARG	OPTEE2_FFA_YIELDING_CALL(0)
+#define OPTEE2_FFA_YIELDING_CALL_RESUME		OPTEE2_FFA_YIELDING_CALL(1)
+
+#define OPTEE2_FFA_YIELDING_CALL_RETURN_DONE		0
+#define OPTEE2_FFA_YIELDING_CALL_RETURN_RPC_CMD		1
+#define OPTEE2_FFA_YIELDING_CALL_RETURN_INTERRUPT	2
+
+#endif /*__OPTEE2_FFA_H*/
diff --git a/drivers/tee/optee2/optee2_msg.h b/drivers/tee/optee2/optee2_msg.h
new file mode 100644
index 000000000000..dcc7c8226e22
--- /dev/null
+++ b/drivers/tee/optee2/optee2_msg.h
@@ -0,0 +1,351 @@
+/* SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause) */
+/*
+ * Copyright (c) 2015-2021, Linaro Limited
+ */
+#ifndef _OPTEE2_MSG_H
+#define _OPTEE2_MSG_H
+
+#include <linux/bitops.h>
+#include <linux/types.h>
+
+/*
+ * This file defines the OP-TEE message protocol (ABI) used to communicate
+ * with an instance of OP-TEE running in secure world.
+ *
+ * This file is divided into two sections.
+ * 1. Formatting of messages.
+ * 2. Requests from normal world
+ */
+
+/*****************************************************************************
+ * Part 1 - formatting of messages
+ *****************************************************************************/
+
+#define OPTEE2_MSG_ATTR_TYPE_NONE		0x0
+#define OPTEE2_MSG_ATTR_TYPE_VALUE_INPUT		0x1
+#define OPTEE2_MSG_ATTR_TYPE_VALUE_OUTPUT	0x2
+#define OPTEE2_MSG_ATTR_TYPE_VALUE_INOUT		0x3
+#define OPTEE2_MSG_ATTR_TYPE_RMEM_INPUT		0x5
+#define OPTEE2_MSG_ATTR_TYPE_RMEM_OUTPUT		0x6
+#define OPTEE2_MSG_ATTR_TYPE_RMEM_INOUT		0x7
+#define OPTEE2_MSG_ATTR_TYPE_FMEM_INPUT		OPTEE2_MSG_ATTR_TYPE_RMEM_INPUT
+#define OPTEE2_MSG_ATTR_TYPE_FMEM_OUTPUT		OPTEE2_MSG_ATTR_TYPE_RMEM_OUTPUT
+#define OPTEE2_MSG_ATTR_TYPE_FMEM_INOUT		OPTEE2_MSG_ATTR_TYPE_RMEM_INOUT
+#define OPTEE2_MSG_ATTR_TYPE_TMEM_INPUT		0x9
+#define OPTEE2_MSG_ATTR_TYPE_TMEM_OUTPUT		0xa
+#define OPTEE2_MSG_ATTR_TYPE_TMEM_INOUT		0xb
+
+#define OPTEE2_MSG_ATTR_TYPE_MASK		GENMASK(7, 0)
+
+/*
+ * Meta parameter to be absorbed by the Secure OS and not passed
+ * to the Trusted Application.
+ *
+ * Currently only used with OPTEE2_MSG_CMD_OPEN_SESSION.
+ */
+#define OPTEE2_MSG_ATTR_META			BIT(8)
+
+/*
+ * Pointer to a list of pages used to register user-defined SHM buffer.
+ * Used with OPTEE2_MSG_ATTR_TYPE_TMEM_*.
+ * buf_ptr should point to the beginning of the buffer. Buffer will contain
+ * list of page addresses. OP-TEE core can reconstruct contiguous buffer from
+ * that page addresses list. Page addresses are stored as 64 bit values.
+ * Last entry on a page should point to the next page of buffer.
+ * Every entry in buffer should point to a 4k page beginning (12 least
+ * significant bits must be equal to zero).
+ *
+ * 12 least significant bits of optee2_msg_param.u.tmem.buf_ptr should hold
+ * page offset of user buffer.
+ *
+ * So, entries should be placed like members of this structure:
+ *
+ * struct page_data {
+ *   uint64_t pages_array[OPTEE2_MSG_NONCONTIG_PAGE_SIZE/sizeof(uint64_t) - 1];
+ *   uint64_t next_page_data;
+ * };
+ *
+ * Structure is designed to exactly fit into the page size
+ * OPTEE2_MSG_NONCONTIG_PAGE_SIZE which is a standard 4KB page.
+ *
+ * The size of 4KB is chosen because this is the smallest page size for ARM
+ * architectures. If REE uses larger pages, it should divide them to 4KB ones.
+ */
+#define OPTEE2_MSG_ATTR_NONCONTIG		BIT(9)
+
+/*
+ * Memory attributes for caching passed with temp memrefs. The actual value
+ * used is defined outside the message protocol with the exception of
+ * OPTEE2_MSG_ATTR_CACHE_PREDEFINED which means the attributes already
+ * defined for the memory range should be used. If optee2_smc.h is used as
+ * bearer of this protocol OPTEE2_SMC_SHM_* is used for values.
+ */
+#define OPTEE2_MSG_ATTR_CACHE_SHIFT		16
+#define OPTEE2_MSG_ATTR_CACHE_MASK		GENMASK(2, 0)
+#define OPTEE2_MSG_ATTR_CACHE_PREDEFINED		0
+
+/*
+ * Same values as TEE_LOGIN_* from TEE Internal API
+ */
+#define OPTEE2_MSG_LOGIN_PUBLIC			0x00000000
+#define OPTEE2_MSG_LOGIN_USER			0x00000001
+#define OPTEE2_MSG_LOGIN_GROUP			0x00000002
+#define OPTEE2_MSG_LOGIN_APPLICATION		0x00000004
+#define OPTEE2_MSG_LOGIN_APPLICATION_USER	0x00000005
+#define OPTEE2_MSG_LOGIN_APPLICATION_GROUP	0x00000006
+
+/*
+ * Page size used in non-contiguous buffer entries
+ */
+#define OPTEE2_MSG_NONCONTIG_PAGE_SIZE		4096
+
+#define OPTEE2_MSG_FMEM_INVALID_GLOBAL_ID	0xffffffffffffffff
+
+/**
+ * struct optee2_msg_param_tmem - temporary memory reference parameter
+ * @buf_ptr:	Address of the buffer
+ * @size:	Size of the buffer
+ * @shm_ref:	Temporary shared memory reference, pointer to a struct tee_shm
+ *
+ * Secure and normal world communicates pointers as physical address
+ * instead of the virtual address. This is because secure and normal world
+ * have completely independent memory mapping. Normal world can even have a
+ * hypervisor which need to translate the guest physical address (AKA IPA
+ * in ARM documentation) to a real physical address before passing the
+ * structure to secure world.
+ */
+struct optee2_msg_param_tmem {
+	u64 buf_ptr;
+	u64 size;
+	u64 shm_ref;
+};
+
+/**
+ * struct optee2_msg_param_rmem - registered memory reference parameter
+ * @offs:	Offset into shared memory reference
+ * @size:	Size of the buffer
+ * @shm_ref:	Shared memory reference, pointer to a struct tee_shm
+ */
+struct optee2_msg_param_rmem {
+	u64 offs;
+	u64 size;
+	u64 shm_ref;
+};
+
+/**
+ * struct optee2_msg_param_fmem - ffa memory reference parameter
+ * @offs_lower:	   Lower bits of offset into shared memory reference
+ * @offs_upper:	   Upper bits of offset into shared memory reference
+ * @internal_offs: Internal offset into the first page of shared memory
+ *		   reference
+ * @size:	   Size of the buffer
+ * @global_id:	   Global identifier of Shared memory
+ */
+struct optee2_msg_param_fmem {
+	u32 offs_low;
+	u16 offs_high;
+	u16 internal_offs;
+	u64 size;
+	u64 global_id;
+};
+
+/**
+ * struct optee2_msg_param_value - opaque value parameter
+ *
+ * Value parameters are passed unchecked between normal and secure world.
+ */
+struct optee2_msg_param_value {
+	u64 a;
+	u64 b;
+	u64 c;
+};
+
+/**
+ * struct optee2_msg_param - parameter used together with struct optee2_msg_arg
+ * @attr:	attributes
+ * @tmem:	parameter by temporary memory reference
+ * @rmem:	parameter by registered memory reference
+ * @fmem:	parameter by ffa registered memory reference
+ * @value:	parameter by opaque value
+ * @octets:	parameter by octet string
+ *
+ * @attr & OPTEE2_MSG_ATTR_TYPE_MASK indicates if tmem, rmem or value is used in
+ * the union. OPTEE2_MSG_ATTR_TYPE_VALUE_* indicates value or octets,
+ * OPTEE2_MSG_ATTR_TYPE_TMEM_* indicates @tmem and
+ * OPTEE2_MSG_ATTR_TYPE_RMEM_* or the alias PTEE_MSG_ATTR_TYPE_FMEM_* indicates
+ * @rmem or @fmem depending on the conduit.
+ * OPTEE2_MSG_ATTR_TYPE_NONE indicates that none of the members are used.
+ */
+struct optee2_msg_param {
+	u64 attr;
+	union {
+		struct optee2_msg_param_tmem tmem;
+		struct optee2_msg_param_rmem rmem;
+		struct optee2_msg_param_fmem fmem;
+		struct optee2_msg_param_value value;
+		u8 octets[24];
+	} u;
+};
+
+/**
+ * struct optee2_msg_arg - call argument
+ * @cmd: Command, one of OPTEE2_MSG_CMD_* or OPTEE2_MSG_RPC_CMD_*
+ * @func: Trusted Application function, specific to the Trusted Application,
+ *	     used if cmd == OPTEE2_MSG_CMD_INVOKE_COMMAND
+ * @session: In parameter for all OPTEE2_MSG_CMD_* except
+ *	     OPTEE2_MSG_CMD_OPEN_SESSION where it's an output parameter instead
+ * @cancel_id: Cancellation id, a unique value to identify this request
+ * @ret: return value
+ * @ret_origin: origin of the return value
+ * @num_params: number of parameters supplied to the OS Command
+ * @params: the parameters supplied to the OS Command
+ *
+ * All normal calls to Trusted OS uses this struct. If cmd requires further
+ * information than what these fields hold it can be passed as a parameter
+ * tagged as meta (setting the OPTEE2_MSG_ATTR_META bit in corresponding
+ * attrs field). All parameters tagged as meta have to come first.
+ */
+struct optee2_msg_arg {
+	u32 cmd;
+	u32 func;
+	u32 session;
+	u32 cancel_id;
+	u32 pad;
+	u32 ret;
+	u32 ret_origin;
+	u32 num_params;
+
+	/* num_params tells the actual number of element in params */
+	struct optee2_msg_param params[];
+};
+
+/**
+ * OPTEE2_MSG_GET_ARG_SIZE - return size of struct optee2_msg_arg
+ *
+ * @num_params: Number of parameters embedded in the struct optee2_msg_arg
+ *
+ * Returns the size of the struct optee2_msg_arg together with the number
+ * of embedded parameters.
+ */
+#define OPTEE2_MSG_GET_ARG_SIZE(num_params) \
+	(sizeof(struct optee2_msg_arg) + \
+	 sizeof(struct optee2_msg_param) * (num_params))
+
+/*****************************************************************************
+ * Part 2 - requests from normal world
+ *****************************************************************************/
+
+/*
+ * Return the following UID if using API specified in this file without
+ * further extensions:
+ * 384fb3e0-e7f8-11e3-af63-0002a5d5c51b.
+ * Represented in 4 32-bit words in OPTEE2_MSG_UID_0, OPTEE2_MSG_UID_1,
+ * OPTEE2_MSG_UID_2, OPTEE2_MSG_UID_3.
+ *
+ * In the case where the OP-TEE image is loaded by the kernel, this will
+ * initially return an alternate UID to reflect that we are communicating with
+ * the TF-A image loading service at that time instead of OP-TEE. That UID is:
+ * a3fbeab1-1246-315d-c7c4-06b9c03cbea4.
+ * Represented in 4 32-bit words in OPTEE2_MSG_IMAGE_LOAD_UID_0,
+ * OPTEE2_MSG_IMAGE_LOAD_UID_1, OPTEE2_MSG_IMAGE_LOAD_UID_2,
+ * OPTEE2_MSG_IMAGE_LOAD_UID_3.
+ */
+#define OPTEE2_MSG_UID_0			0x384fb3e0
+#define OPTEE2_MSG_UID_1			0xe7f811e3
+#define OPTEE2_MSG_UID_2			0xaf630002
+#define OPTEE2_MSG_UID_3			0xa5d5c51b
+#define OPTEE2_MSG_IMAGE_LOAD_UID_0	0xa3fbeab1
+#define OPTEE2_MSG_IMAGE_LOAD_UID_1	0x1246315d
+#define OPTEE2_MSG_IMAGE_LOAD_UID_2	0xc7c406b9
+#define OPTEE2_MSG_IMAGE_LOAD_UID_3	0xc03cbea4
+#define OPTEE2_MSG_FUNCID_CALLS_UID	0xFF01
+
+/*
+ * Returns 2.0 if using API specified in this file without further
+ * extensions. Represented in 2 32-bit words in OPTEE2_MSG_REVISION_MAJOR
+ * and OPTEE2_MSG_REVISION_MINOR
+ */
+#define OPTEE2_MSG_REVISION_MAJOR	2
+#define OPTEE2_MSG_REVISION_MINOR	0
+#define OPTEE2_MSG_FUNCID_CALLS_REVISION	0xFF03
+
+/*
+ * Get UUID of Trusted OS.
+ *
+ * Used by non-secure world to figure out which Trusted OS is installed.
+ * Note that returned UUID is the UUID of the Trusted OS, not of the API.
+ *
+ * Returns UUID in 4 32-bit words in the same way as
+ * OPTEE2_MSG_FUNCID_CALLS_UID described above.
+ */
+#define OPTEE2_MSG_OS_OPTEE2_UUID_0	0x486178e0
+#define OPTEE2_MSG_OS_OPTEE2_UUID_1	0xe7f811e3
+#define OPTEE2_MSG_OS_OPTEE2_UUID_2	0xbc5e0002
+#define OPTEE2_MSG_OS_OPTEE2_UUID_3	0xa5d5c51b
+#define OPTEE2_MSG_FUNCID_GET_OS_UUID	0x0000
+
+/*
+ * Get revision of Trusted OS.
+ *
+ * Used by non-secure world to figure out which version of the Trusted OS
+ * is installed. Note that the returned revision is the revision of the
+ * Trusted OS, not of the API.
+ *
+ * Returns revision in 2 32-bit words in the same way as
+ * OPTEE2_MSG_CALLS_REVISION described above.
+ */
+#define OPTEE2_MSG_FUNCID_GET_OS_REVISION	0x0001
+
+/*
+ * Do a secure call with struct optee2_msg_arg as argument
+ * The OPTEE2_MSG_CMD_* below defines what goes in struct optee2_msg_arg::cmd
+ *
+ * OPTEE2_MSG_CMD_OPEN_SESSION opens a session to a Trusted Application.
+ * The first two parameters are tagged as meta, holding two value
+ * parameters to pass the following information:
+ * param[0].u.value.a-b uuid of Trusted Application
+ * param[1].u.value.a-b uuid of Client
+ * param[1].u.value.c Login class of client OPTEE2_MSG_LOGIN_*
+ *
+ * OPTEE2_MSG_CMD_INVOKE_COMMAND invokes a command a previously opened
+ * session to a Trusted Application.  struct optee2_msg_arg::func is Trusted
+ * Application function, specific to the Trusted Application.
+ *
+ * OPTEE2_MSG_CMD_CLOSE_SESSION closes a previously opened session to
+ * Trusted Application.
+ *
+ * OPTEE2_MSG_CMD_CANCEL cancels a currently invoked command.
+ *
+ * OPTEE2_MSG_CMD_REGISTER_SHM registers a shared memory reference. The
+ * information is passed as:
+ * [in] param[0].attr			OPTEE2_MSG_ATTR_TYPE_TMEM_INPUT
+ *					[| OPTEE2_MSG_ATTR_NONCONTIG]
+ * [in] param[0].u.tmem.buf_ptr		physical address (of first fragment)
+ * [in] param[0].u.tmem.size		size (of first fragment)
+ * [in] param[0].u.tmem.shm_ref		holds shared memory reference
+ *
+ * OPTEE2_MSG_CMD_UNREGISTER_SHM unregisters a previously registered shared
+ * memory reference. The information is passed as:
+ * [in] param[0].attr			OPTEE2_MSG_ATTR_TYPE_RMEM_INPUT
+ * [in] param[0].u.rmem.shm_ref		holds shared memory reference
+ * [in] param[0].u.rmem.offs		0
+ * [in] param[0].u.rmem.size		0
+ *
+ * OPTEE2_MSG_CMD_DO_BOTTOM_HALF does the scheduled bottom half processing
+ * of a driver.
+ *
+ * OPTEE2_MSG_CMD_STOP_ASYNC_NOTIF informs secure world that from now is
+ * normal world unable to process asynchronous notifications. Typically
+ * used when the driver is shut down.
+ */
+#define OPTEE2_MSG_CMD_OPEN_SESSION	0
+#define OPTEE2_MSG_CMD_INVOKE_COMMAND	1
+#define OPTEE2_MSG_CMD_CLOSE_SESSION	2
+#define OPTEE2_MSG_CMD_CANCEL		3
+#define OPTEE2_MSG_CMD_REGISTER_SHM	4
+#define OPTEE2_MSG_CMD_UNREGISTER_SHM	5
+#define OPTEE2_MSG_CMD_DO_BOTTOM_HALF	6
+#define OPTEE2_MSG_CMD_STOP_ASYNC_NOTIF	7
+#define OPTEE2_MSG_FUNCID_CALL_WITH_ARG	0x0004
+
+#endif /* _OPTEE2_MSG_H */
diff --git a/drivers/tee/optee2/optee2_private.h b/drivers/tee/optee2/optee2_private.h
new file mode 100644
index 000000000000..56f22d71e7a9
--- /dev/null
+++ b/drivers/tee/optee2/optee2_private.h
@@ -0,0 +1,353 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Copyright (c) 2015-2021, Linaro Limited
+ */
+
+#ifndef OPTEE2_PRIVATE_H
+#define OPTEE2_PRIVATE_H
+
+#if defined(CONFIG_HAVE_ARM_SMCCC)
+#include <linux/arm-smccc.h>
+#elif defined(CONFIG_RISCV_SBI)
+#include "optee2_sbi.h"
+#endif
+#include <linux/rhashtable.h>
+#include <linux/semaphore.h>
+#include <linux/tee_drv.h>
+#include <linux/types.h>
+#include "optee2_msg.h"
+
+#define DRIVER_NAME "optee2"
+
+#define OPTEE2_MAX_ARG_SIZE	1024
+
+/* Some Global Platform error codes used in this driver */
+#define TEEC_SUCCESS			0x00000000
+#define TEEC_ERROR_BAD_PARAMETERS	0xFFFF0006
+#define TEEC_ERROR_NOT_SUPPORTED	0xFFFF000A
+#define TEEC_ERROR_COMMUNICATION	0xFFFF000E
+#define TEEC_ERROR_OUT_OF_MEMORY	0xFFFF000C
+#define TEEC_ERROR_BUSY			0xFFFF000D
+#define TEEC_ERROR_SHORT_BUFFER		0xFFFF0010
+
+#define TEEC_ORIGIN_COMMS		0x00000002
+
+/*
+ * This value should be larger than the number threads in secure world to
+ * meet the need from secure world. The number of threads in secure world
+ * are usually not even close to 255 so we should be safe for now.
+ */
+#define OPTEE2_DEFAULT_MAX_NOTIF_VALUE	255
+
+typedef struct arm_smccc_res optee2_res_t;
+
+typedef void (optee2_invoke_fn)(unsigned long, unsigned long, unsigned long,
+				unsigned long, unsigned long, unsigned long,
+				unsigned long, unsigned long,
+				optee2_res_t *);
+
+struct optee2_call_waiter {
+	struct list_head list_node;
+	struct completion c;
+};
+
+struct optee2_call_queue {
+	/* Serializes access to this struct */
+	struct mutex mutex;
+	struct list_head waiters;
+};
+
+struct optee2_notif {
+	u_int max_key;
+	/* Serializes access to the elements below in this struct */
+	spinlock_t lock;
+	struct list_head db;
+	u_long *bitmap;
+};
+
+#define OPTEE2_SHM_ARG_ALLOC_PRIV	BIT(0)
+#define OPTEE2_SHM_ARG_SHARED		BIT(1)
+struct optee2_shm_arg_entry;
+struct optee2_shm_arg_cache {
+	u32 flags;
+	/* Serializes access to this struct */
+	struct mutex mutex;
+	struct list_head shm_args;
+};
+
+/**
+ * struct optee2_supp - supplicant synchronization struct
+ * @ctx			the context of current connected supplicant.
+ *			if !NULL the supplicant device is available for use,
+ *			else busy
+ * @mutex:		held while accessing content of this struct
+ * @req_id:		current request id if supplicant is doing synchronous
+ *			communication, else -1
+ * @reqs:		queued request not yet retrieved by supplicant
+ * @idr:		IDR holding all requests currently being processed
+ *			by supplicant
+ * @reqs_c:		completion used by supplicant when waiting for a
+ *			request to be queued.
+ */
+struct optee2_supp {
+	/* Serializes access to this struct */
+	struct mutex mutex;
+	struct tee_context *ctx;
+
+	int req_id;
+	struct list_head reqs;
+	struct idr idr;
+	struct completion reqs_c;
+};
+
+/*
+ * struct optee2_pcpu - per cpu notif private struct passed to work functions
+ * @optee2		optee2 device reference
+ */
+struct optee2_pcpu {
+	struct optee2 *optee2;
+};
+
+/*
+ * struct optee2_smc - optee2 smc communication struct
+ * @invoke_fn		handler function to invoke secure monitor
+ * @memremaped_shm	virtual address of memory in shared memory pool
+ * @sec_caps:		secure world capabilities defined by
+ *			OPTEE2_SMC_SEC_CAP_* in optee2_smc.h
+ * @notif_irq		interrupt used as async notification by OP-TEE or 0
+ * @optee2_pcpu		per_cpu optee2 instance for per cpu work or NULL
+ * @notif_pcpu_wq	workqueue for per cpu asynchronous notification or NULL
+ * @notif_pcpu_work	work for per cpu asynchronous notification
+ * @notif_cpuhp_state   CPU hotplug state assigned for pcpu interrupt management
+ */
+struct optee2_smc {
+	optee2_invoke_fn *invoke_fn;
+	void *memremaped_shm;
+	u32 sec_caps;
+	unsigned int notif_irq;
+	struct optee2_pcpu __percpu *optee2_pcpu;
+	struct workqueue_struct *notif_pcpu_wq;
+	struct work_struct notif_pcpu_work;
+	unsigned int notif_cpuhp_state;
+};
+
+/**
+ * struct optee2_ffa_data -  FFA communication struct
+ * @ffa_dev		FFA device, contains the destination id, the id of
+ *			OP-TEE in secure world
+ * @ffa_ops		FFA operations
+ * @mutex		Serializes access to @global_ids
+ * @global_ids		FF-A shared memory global handle translation
+ */
+struct optee2_ffa {
+	struct ffa_device *ffa_dev;
+	/* Serializes access to @global_ids */
+	struct mutex mutex;
+	struct rhashtable global_ids;
+};
+
+struct optee2;
+
+/**
+ * struct optee2_ops - OP-TEE driver internal operations
+ * @do_call_with_arg:	enters OP-TEE in secure world
+ * @to_msg_param:	converts from struct tee_param to OPTEE2_MSG parameters
+ * @from_msg_param:	converts from OPTEE2_MSG parameters to struct tee_param
+ *
+ * These OPs are only supposed to be used internally in the OP-TEE driver
+ * as a way of abstracting the different methogs of entering OP-TEE in
+ * secure world.
+ */
+struct optee2_ops {
+	int (*do_call_with_arg)(struct tee_context *ctx,
+				struct tee_shm *shm_arg, u_int offs);
+	int (*to_msg_param)(struct optee2 *optee2,
+			    struct optee2_msg_param *msg_params,
+			    size_t num_params, const struct tee_param *params);
+	int (*from_msg_param)(struct optee2 *optee2, struct tee_param *params,
+			      size_t num_params,
+			      const struct optee2_msg_param *msg_params);
+};
+
+/**
+ * struct optee2 - main service struct
+ * @supp_teedev:	supplicant device
+ * @teedev:		client device
+ * @ops:		internal callbacks for different ways to reach secure
+ *			world
+ * @ctx:		driver internal TEE context
+ * @smc:		specific to SMC ABI
+ * @ffa:		specific to FF-A ABI
+ * @call_queue:		queue of threads waiting to call @invoke_fn
+ * @notif:		notification synchronization struct
+ * @supp:		supplicant synchronization struct for RPC to supplicant
+ * @pool:		shared memory pool
+ * @rpc_param_count:	If > 0 number of RPC parameters to make room for
+ * @scan_bus_done	flag if device registation was already done.
+ * @scan_bus_wq		workqueue to scan optee2 bus and register optee2 drivers
+ * @scan_bus_work	workq to scan optee2 bus and register optee2 drivers
+ */
+struct optee2 {
+	struct tee_device *supp_teedev;
+	struct tee_device *teedev;
+	const struct optee2_ops *ops;
+	struct tee_context *ctx;
+	union {
+		struct optee2_smc smc;
+		struct optee2_ffa ffa;
+	};
+	struct optee2_shm_arg_cache shm_arg_cache;
+	struct optee2_call_queue call_queue;
+	struct optee2_notif notif;
+	struct optee2_supp supp;
+	struct tee_shm_pool *pool;
+	unsigned int rpc_param_count;
+	bool   scan_bus_done;
+	struct workqueue_struct *scan_bus_wq;
+	struct work_struct scan_bus_work;
+};
+
+struct optee2_session {
+	struct list_head list_node;
+	u32 session_id;
+};
+
+struct optee2_context_data {
+	/* Serializes access to this struct */
+	struct mutex mutex;
+	struct list_head sess_list;
+};
+
+struct optee2_rpc_param {
+	u32	a0;
+	u32	a1;
+	u32	a2;
+	u32	a3;
+	u32	a4;
+	u32	a5;
+	u32	a6;
+	u32	a7;
+};
+
+/* Holds context that is preserved during one STD call */
+struct optee2_call_ctx {
+	/* information about pages list used in last allocation */
+	void *pages_list;
+	size_t num_entries;
+};
+
+int optee2_notif_init(struct optee2 *optee2, u_int max_key);
+void optee2_notif_uninit(struct optee2 *optee2);
+int optee2_notif_wait(struct optee2 *optee2, u_int key);
+int optee2_notif_send(struct optee2 *optee2, u_int key);
+
+u32 optee2_supp_thrd_req(struct tee_context *ctx, u32 func, size_t num_params,
+			struct tee_param *param);
+
+void optee2_supp_init(struct optee2_supp *supp);
+void optee2_supp_uninit(struct optee2_supp *supp);
+void optee2_supp_release(struct optee2_supp *supp);
+
+int optee2_supp_recv(struct tee_context *ctx, u32 *func, u32 *num_params,
+		    struct tee_param *param);
+int optee2_supp_send(struct tee_context *ctx, u32 ret, u32 num_params,
+		    struct tee_param *param);
+
+int optee2_open_session(struct tee_context *ctx,
+		       struct tee_ioctl_open_session_arg *arg,
+		       struct tee_param *param);
+int optee2_close_session_helper(struct tee_context *ctx, u32 session);
+int optee2_close_session(struct tee_context *ctx, u32 session);
+int optee2_invoke_func(struct tee_context *ctx, struct tee_ioctl_invoke_arg *arg,
+		      struct tee_param *param);
+int optee2_cancel_req(struct tee_context *ctx, u32 cancel_id, u32 session);
+
+#define PTA_CMD_GET_DEVICES		0x0
+#define PTA_CMD_GET_DEVICES_SUPP	0x1
+int optee2_enumerate_devices(u32 func);
+void optee2_unregister_devices(void);
+
+int optee2_pool_op_alloc_helper(struct tee_shm_pool *pool, struct tee_shm *shm,
+			       size_t size, size_t align,
+			       int (*shm_register)(struct tee_context *ctx,
+						   struct tee_shm *shm,
+						   struct page **pages,
+						   size_t num_pages,
+						   unsigned long start));
+void optee2_pool_op_free_helper(struct tee_shm_pool *pool, struct tee_shm *shm,
+			       int (*shm_unregister)(struct tee_context *ctx,
+						     struct tee_shm *shm));
+
+
+void optee2_remove_common(struct optee2 *optee2);
+int optee2_open(struct tee_context *ctx, bool cap_memref_null);
+void optee2_release(struct tee_context *ctx);
+void optee2_release_supp(struct tee_context *ctx);
+
+static inline void optee2_from_msg_param_value(struct tee_param *p, u32 attr,
+					      const struct optee2_msg_param *mp)
+{
+	p->attr = TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT +
+		  attr - OPTEE2_MSG_ATTR_TYPE_VALUE_INPUT;
+	p->u.value.a = mp->u.value.a;
+	p->u.value.b = mp->u.value.b;
+	p->u.value.c = mp->u.value.c;
+}
+
+static inline void optee2_to_msg_param_value(struct optee2_msg_param *mp,
+					    const struct tee_param *p)
+{
+	mp->attr = OPTEE2_MSG_ATTR_TYPE_VALUE_INPUT + p->attr -
+		   TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT;
+	mp->u.value.a = p->u.value.a;
+	mp->u.value.b = p->u.value.b;
+	mp->u.value.c = p->u.value.c;
+}
+
+void optee2_cq_wait_init(struct optee2_call_queue *cq,
+			struct optee2_call_waiter *w);
+void optee2_cq_wait_for_completion(struct optee2_call_queue *cq,
+				  struct optee2_call_waiter *w);
+void optee2_cq_wait_final(struct optee2_call_queue *cq,
+			 struct optee2_call_waiter *w);
+int optee2_check_mem_type(unsigned long start, size_t num_pages);
+
+void optee2_shm_arg_cache_init(struct optee2 *optee2, u32 flags);
+void optee2_shm_arg_cache_uninit(struct optee2 *optee2);
+struct optee2_msg_arg *optee2_get_msg_arg(struct tee_context *ctx,
+					size_t num_params,
+					struct optee2_shm_arg_entry **entry,
+					struct tee_shm **shm_ret,
+					u_int *offs);
+void optee2_free_msg_arg(struct tee_context *ctx,
+			struct optee2_shm_arg_entry *entry, u_int offs);
+size_t optee2_msg_arg_size(size_t rpc_param_count);
+
+
+struct tee_shm *optee2_rpc_cmd_alloc_suppl(struct tee_context *ctx, size_t sz);
+void optee2_rpc_cmd_free_suppl(struct tee_context *ctx, struct tee_shm *shm);
+void optee2_rpc_cmd(struct tee_context *ctx, struct optee2 *optee2,
+		   struct optee2_msg_arg *arg);
+
+/*
+ * Small helpers
+ */
+
+static inline void *reg_pair_to_ptr(u32 reg0, u32 reg1)
+{
+	return (void *)(unsigned long)(((u64)reg0 << 32) | reg1);
+}
+
+static inline void reg_pair_from_64(u32 *reg0, u32 *reg1, u64 val)
+{
+	*reg0 = val >> 32;
+	*reg1 = val;
+}
+
+/* Registration of the ABIs */
+int optee2_smc_abi_register(void);
+void optee2_smc_abi_unregister(void);
+int optee2_ffa_abi_register(void);
+void optee2_ffa_abi_unregister(void);
+
+#endif /*OPTEE2_PRIVATE_H*/
diff --git a/drivers/tee/optee2/optee2_rpc_cmd.h b/drivers/tee/optee2/optee2_rpc_cmd.h
new file mode 100644
index 000000000000..2c3a6b5f1f6f
--- /dev/null
+++ b/drivers/tee/optee2/optee2_rpc_cmd.h
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (c) 2016-2021, Linaro Limited
+ */
+
+#ifndef __OPTEE2_RPC_CMD_H
+#define __OPTEE2_RPC_CMD_H
+
+/*
+ * All RPC is done with a struct optee2_msg_arg as bearer of information,
+ * struct optee2_msg_arg::arg holds values defined by OPTEE2_RPC_CMD_* below.
+ * Only the commands handled by the kernel driver are defined here.
+ *
+ * RPC communication with tee-supplicant is reversed compared to normal
+ * client communication described above. The supplicant receives requests
+ * and sends responses.
+ */
+
+/*
+ * Get time
+ *
+ * Returns number of seconds and nano seconds since the Epoch,
+ * 1970-01-01 00:00:00 +0000 (UTC).
+ *
+ * [out]    value[0].a	    Number of seconds
+ * [out]    value[0].b	    Number of nano seconds.
+ */
+#define OPTEE2_RPC_CMD_GET_TIME		3
+
+/*
+ * Notification from/to secure world.
+ *
+ * If secure world needs to wait for something, for instance a mutex, it
+ * does a notification wait request instead of spinning in secure world.
+ * Conversely can a synchronous notification can be sent when a secure
+ * world mutex with a thread waiting thread is unlocked.
+ *
+ * This interface can also be used to wait for a asynchronous notification
+ * which instead is sent via a non-secure interrupt.
+ *
+ * Waiting on notification
+ * [in]    value[0].a	    OPTEE2_RPC_NOTIFICATION_WAIT
+ * [in]    value[0].b	    notification value
+ *
+ * Sending a synchronous notification
+ * [in]    value[0].a	    OPTEE2_RPC_NOTIFICATION_SEND
+ * [in]    value[0].b	    notification value
+ */
+#define OPTEE2_RPC_CMD_NOTIFICATION	4
+#define OPTEE2_RPC_NOTIFICATION_WAIT	0
+#define OPTEE2_RPC_NOTIFICATION_SEND	1
+
+/*
+ * Suspend execution
+ *
+ * [in]    value[0].a	Number of milliseconds to suspend
+ */
+#define OPTEE2_RPC_CMD_SUSPEND		5
+
+/*
+ * Allocate a piece of shared memory
+ *
+ * [in]    value[0].a	    Type of memory one of
+ *			    OPTEE2_RPC_SHM_TYPE_* below
+ * [in]    value[0].b	    Requested size
+ * [in]    value[0].c	    Required alignment
+ * [out]   memref[0]	    Buffer
+ */
+#define OPTEE2_RPC_CMD_SHM_ALLOC		6
+/* Memory that can be shared with a non-secure user space application */
+#define OPTEE2_RPC_SHM_TYPE_APPL		0
+/* Memory only shared with non-secure kernel */
+#define OPTEE2_RPC_SHM_TYPE_KERNEL	1
+
+/*
+ * Free shared memory previously allocated with OPTEE2_RPC_CMD_SHM_ALLOC
+ *
+ * [in]     value[0].a	    Type of memory one of
+ *			    OPTEE2_RPC_SHM_TYPE_* above
+ * [in]     value[0].b	    Value of shared memory reference or cookie
+ */
+#define OPTEE2_RPC_CMD_SHM_FREE		7
+
+/*
+ * Issue master requests (read and write operations) to an I2C chip.
+ *
+ * [in]     value[0].a	    Transfer mode (OPTEE2_RPC_I2C_TRANSFER_*)
+ * [in]     value[0].b	    The I2C bus (a.k.a adapter).
+ *				16 bit field.
+ * [in]     value[0].c	    The I2C chip (a.k.a address).
+ *				16 bit field (either 7 or 10 bit effective).
+ * [in]     value[1].a	    The I2C master control flags (ie, 10 bit address).
+ *				16 bit field.
+ * [in/out] memref[2]	    Buffer used for data transfers.
+ * [out]    value[3].a	    Number of bytes transferred by the REE.
+ */
+#define OPTEE2_RPC_CMD_I2C_TRANSFER	21
+
+/* I2C master transfer modes */
+#define OPTEE2_RPC_I2C_TRANSFER_RD	0
+#define OPTEE2_RPC_I2C_TRANSFER_WR	1
+
+/* I2C master control flags */
+#define OPTEE2_RPC_I2C_FLAGS_TEN_BIT	BIT(0)
+
+#endif /*__OPTEE2_RPC_CMD_H*/
diff --git a/drivers/tee/optee2/optee2_sbi.h b/drivers/tee/optee2/optee2_sbi.h
new file mode 100644
index 000000000000..f6eedd9d5a2b
--- /dev/null
+++ b/drivers/tee/optee2/optee2_sbi.h
@@ -0,0 +1,513 @@
+/* SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause) */
+/*
+ * Copyright (c) 2015-2019, Linaro Limited
+ */
+#ifndef OPTEE2_SBI_H
+#define OPTEE2_SBI_H
+
+// #include <linux/riscv-sbicc.h>
+#include <linux/bitops.h>
+
+
+#define SBI_EXTID_TEE (0x544545)
+
+#if defined(CONFIG_HAVE_RISCV_SBI)
+typedef struct arm_smccc_res optee2_res;
+#elif defined(CONFIG_RISCV_SBI)
+/**
+ * optee2_res_t - Result from SMC/HVC call
+ * @a0-a3 result values from registers 0 to 3
+ */
+struct sbiret {
+	unsigned long a0;
+	unsigned long a1;
+	unsigned long a2;
+	unsigned long a3;
+};
+
+typedef struct sbiret optee2_res_t;
+
+#endif
+
+#define RISCV_SBI_STD_CALL	        (0UL)
+#define RISCV_SBI_FAST_CALL	        (1UL)
+#define RISCV_SBI_TYPE_SHIFT		31
+
+#define RISCV_SBI_SMC_32		0
+#define RISCV_SBI_SMC_64		1
+#define RISCV_SBI_CALL_CONV_SHIFT	30
+
+#define RISCV_SBI_OWNER_MASK		0x3F
+#define RISCV_SBI_OWNER_SHIFT		24
+
+#define RISCV_SBI_FUNC_MASK		0xFFFF
+
+#define RISCV_SBI_IS_FAST_CALL(smc_val)	\
+	((smc_val) & (RISCV_SBI_FAST_CALL << RISCV_SBI_TYPE_SHIFT))
+#define RISCV_SBI_IS_64(smc_val) \
+	((smc_val) & (RISCV_SBI_SMC_64 << RISCV_SBI_CALL_CONV_SHIFT))
+#define RISCV_SBI_FUNC_NUM(smc_val)	((smc_val) & RISCV_SBI_FUNC_MASK)
+#define RISCV_SBI_OWNER_NUM(smc_val) \
+	(((smc_val) >> RISCV_SBI_OWNER_SHIFT) & RISCV_SBI_OWNER_MASK)
+
+#define RISCV_SBI_CALL_VAL(type, calling_convention, owner, func_num) \
+	(((type) << RISCV_SBI_TYPE_SHIFT) | \
+	((calling_convention) << RISCV_SBI_CALL_CONV_SHIFT) | \
+	(((owner) & RISCV_SBI_OWNER_MASK) << RISCV_SBI_OWNER_SHIFT) | \
+	((func_num) & RISCV_SBI_FUNC_MASK))
+
+#define RISCV_SBI_OWNER_ARCH		0
+#define RISCV_SBI_OWNER_CPU		1
+#define RISCV_SBI_OWNER_SIP		2
+#define RISCV_SBI_OWNER_OEM		3
+#define RISCV_SBI_OWNER_STANDARD	4
+#define RISCV_SBI_OWNER_STANDARD_HYP	5
+#define RISCV_SBI_OWNER_VENDOR_HYP	6
+#define RISCV_SBI_OWNER_TRUSTED_APP	48
+#define RISCV_SBI_OWNER_TRUSTED_APP_END	49
+#define RISCV_SBI_OWNER_TRUSTED_OS	50
+#define RISCV_SBI_OWNER_TRUSTED_OS_END	63
+
+#define RISCV_SBI_QUIRK_NONE		0
+#define RISCV_SBI_QUIRK_QCOM_A6		1 /* Save/restore register a6 */
+
+#define RISCV_SBI_VERSION_1_0		0x10000
+#define RISCV_SBI_VERSION_1_1		0x10001
+#define RISCV_SBI_VERSION_1_2		0x10002
+
+#define OPTEE2_SMC_STD_CALL_VAL(func_num) \
+	RISCV_SBI_CALL_VAL(RISCV_SBI_STD_CALL, RISCV_SBI_SMC_32, \
+			   RISCV_SBI_OWNER_TRUSTED_OS, (func_num))
+#define OPTEE2_SMC_FAST_CALL_VAL(func_num) \
+	RISCV_SBI_CALL_VAL(RISCV_SBI_FAST_CALL, RISCV_SBI_SMC_32, \
+			   RISCV_SBI_OWNER_TRUSTED_OS, (func_num))
+
+/*
+ * Function specified by SMC Calling convention.
+ */
+#define OPTEE2_SMC_FUNCID_CALLS_COUNT	0xFF00
+#define OPTEE2_SMC_CALLS_COUNT \
+	RISCV_SBI_CALL_VAL(OPTEE2_SMC_FAST_CALL, SMCCC_SMC_32, \
+			   SMCCC_OWNER_TRUSTED_OS_END, \
+			   OPTEE2_SMC_FUNCID_CALLS_COUNT)
+
+/*
+ * Normal cached memory (write-back), shareable for SMP systems and not
+ * shareable for UP systems.
+ */
+#define OPTEE2_SMC_SHM_CACHED		1
+
+/*
+ * a0..a7 is used as register names in the descriptions below, on arm32
+ * that translates to r0..r7 and on arm64 to w0..w7. In both cases it's
+ * 32-bit registers.
+ */
+
+/*
+ * Function specified by SMC Calling convention
+ *
+ * Return one of the following UIDs if using API specified in this file
+ * without further extentions:
+ * 65cb6b93-af0c-4617-8ed6-644a8d1140f8
+ * see also OPTEE2_SMC_UID_* in optee2_msg.h
+ */
+#define OPTEE2_SMC_FUNCID_CALLS_UID OPTEE2_MSG_FUNCID_CALLS_UID
+#define OPTEE2_SMC_CALLS_UID \
+	RISCV_SBI_CALL_VAL(RISCV_SBI_FAST_CALL, RISCV_SBI_SMC_32, \
+			   RISCV_SBI_OWNER_TRUSTED_OS_END, \
+			   OPTEE2_SMC_FUNCID_CALLS_UID)
+
+/*
+ * Function specified by SMC Calling convention
+ *
+ * Returns 2.0 if using API specified in this file without further extentions.
+ * see also OPTEE2_MSG_REVISION_* in optee2_msg.h
+ */
+#define OPTEE2_SMC_FUNCID_CALLS_REVISION OPTEE2_MSG_FUNCID_CALLS_REVISION
+#define OPTEE2_SMC_CALLS_REVISION \
+	RISCV_SBI_CALL_VAL(RISCV_SBI_FAST_CALL, RISCV_SBI_SMC_32, \
+			   RISCV_SBI_OWNER_TRUSTED_OS_END, \
+			   OPTEE2_SMC_FUNCID_CALLS_REVISION)
+
+struct optee2_smc_calls_revision_result {
+	unsigned long major;
+	unsigned long minor;
+	unsigned long reserved0;
+	unsigned long reserved1;
+};
+
+/*
+ * Get UUID of Trusted OS.
+ *
+ * Used by non-secure world to figure out which Trusted OS is installed.
+ * Note that returned UUID is the UUID of the Trusted OS, not of the API.
+ *
+ * Returns UUID in a0-4 in the same way as OPTEE2_SMC_CALLS_UID
+ * described above.
+ */
+#define OPTEE2_SMC_FUNCID_GET_OS_UUID OPTEE2_MSG_FUNCID_GET_OS_UUID
+#define OPTEE2_SMC_CALL_GET_OS_UUID \
+	OPTEE2_SMC_FAST_CALL_VAL(OPTEE2_SMC_FUNCID_GET_OS_UUID)
+
+/*
+ * Get revision of Trusted OS.
+ *
+ * Used by non-secure world to figure out which version of the Trusted OS
+ * is installed. Note that the returned revision is the revision of the
+ * Trusted OS, not of the API.
+ *
+ * Returns revision in a0-1 in the same way as OPTEE2_SMC_CALLS_REVISION
+ * described above. May optionally return a 32-bit build identifier in a2,
+ * with zero meaning unspecified.
+ */
+#define OPTEE2_SMC_FUNCID_GET_OS_REVISION OPTEE2_MSG_FUNCID_GET_OS_REVISION
+#define OPTEE2_SMC_CALL_GET_OS_REVISION \
+	OPTEE2_SMC_FAST_CALL_VAL(OPTEE2_SMC_FUNCID_GET_OS_REVISION)
+
+struct optee2_smc_call_get_os_revision_result {
+	unsigned long major;
+	unsigned long minor;
+	unsigned long build_id;
+	unsigned long reserved1;
+};
+
+/*
+ * Call with struct optee2_msg_arg as argument
+ *
+ * Call register usage:
+ * a0	SMC Function ID, OPTEE2_SMC*CALL_WITH_ARG
+ * a1	Upper 32bit of a 64bit physical pointer to a struct optee2_msg_arg
+ * a2	Lower 32bit of a 64bit physical pointer to a struct optee2_msg_arg
+ * a3	Cache settings, not used if physical pointer is in a predefined shared
+ *	memory area else per OPTEE2_SMC_SHM_*
+ * a4-6	Not used
+ * a7	Hypervisor Client ID register
+ *
+ * Normal return register usage:
+ * a0	Return value, OPTEE2_SMC_RETURN_*
+ * a1-3	Not used
+ * a4-7	Preserved
+ *
+ * OPTEE2_SMC_RETURN_ETHREAD_LIMIT return register usage:
+ * a0	Return value, OPTEE2_SMC_RETURN_ETHREAD_LIMIT
+ * a1-3	Preserved
+ * a4-7	Preserved
+ *
+ * RPC return register usage:
+ * a0	Return value, OPTEE2_SMC_RETURN_IS_RPC(val)
+ * a1-2	RPC parameters
+ * a3-7	Resume information, must be preserved
+ *
+ * Possible return values:
+ * OPTEE2_SMC_RETURN_UNKNOWN_FUNCTION	Trusted OS does not recognize this
+ *					function.
+ * OPTEE2_SMC_RETURN_OK			Call completed, result updated in
+ *					the previously supplied struct
+ *					optee2_msg_arg.
+ * OPTEE2_SMC_RETURN_ETHREAD_LIMIT	Number of Trusted OS threads exceeded,
+ *					try again later.
+ * OPTEE2_SMC_RETURN_EBADADDR		Bad physcial pointer to struct
+ *					optee2_msg_arg.
+ * OPTEE2_SMC_RETURN_EBADCMD		Bad/unknown cmd in struct optee2_msg_arg
+ * OPTEE2_SMC_RETURN_IS_RPC()		Call suspended by RPC call to normal
+ *					world.
+ */
+#define OPTEE2_SMC_FUNCID_CALL_WITH_ARG OPTEE2_MSG_FUNCID_CALL_WITH_ARG
+#define OPTEE2_SMC_CALL_WITH_ARG \
+	OPTEE2_SMC_STD_CALL_VAL(OPTEE2_SMC_FUNCID_CALL_WITH_ARG)
+
+/*
+ * Get Shared Memory Config
+ *
+ * Returns the Secure/Non-secure shared memory config.
+ *
+ * Call register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_GET_SHM_CONFIG
+ * a1-6	Not used
+ * a7	Hypervisor Client ID register
+ *
+ * Have config return register usage:
+ * a0	OPTEE2_SMC_RETURN_OK
+ * a1	Physical address of start of SHM
+ * a2	Size of of SHM
+ * a3	Cache settings of memory, as defined by the
+ *	OPTEE2_SMC_SHM_* values above
+ * a4-7	Preserved
+ *
+ * Not available register usage:
+ * a0	OPTEE2_SMC_RETURN_ENOTAVAIL
+ * a1-3 Not used
+ * a4-7	Preserved
+ */
+#define OPTEE2_SMC_FUNCID_GET_SHM_CONFIG	7
+#define OPTEE2_SMC_GET_SHM_CONFIG \
+	OPTEE2_SMC_FAST_CALL_VAL(OPTEE2_SMC_FUNCID_GET_SHM_CONFIG)
+
+struct optee2_smc_get_shm_config_result {
+	unsigned long status;
+	unsigned long start;
+	unsigned long size;
+	unsigned long settings;
+};
+
+/*
+ * Exchanges capabilities between normal world and secure world
+ *
+ * Call register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_EXCHANGE_CAPABILITIES
+ * a1	bitfield of normal world capabilities OPTEE2_SMC_NSEC_CAP_*
+ * a2-6	Not used
+ * a7	Hypervisor Client ID register
+ *
+ * Normal return register usage:
+ * a0	OPTEE2_SMC_RETURN_OK
+ * a1	bitfield of secure world capabilities OPTEE2_SMC_SEC_CAP_*
+ * a2-7	Preserved
+ *
+ * Error return register usage:
+ * a0	OPTEE2_SMC_RETURN_ENOTAVAIL, can't use the capabilities from normal world
+ * a1	bitfield of secure world capabilities OPTEE2_SMC_SEC_CAP_*
+ * a2-7 Preserved
+ */
+/* Normal world works as a uniprocessor system */
+#define OPTEE2_SMC_NSEC_CAP_UNIPROCESSOR		BIT(0)
+/* Secure world has reserved shared memory for normal world to use */
+#define OPTEE2_SMC_SEC_CAP_HAVE_RESERVED_SHM	BIT(0)
+/* Secure world can communicate via previously unregistered shared memory */
+#define OPTEE2_SMC_SEC_CAP_UNREGISTERED_SHM	BIT(1)
+
+/*
+ * Secure world supports commands "register/unregister shared memory",
+ * secure world accepts command buffers located in any parts of non-secure RAM
+ */
+#define OPTEE2_SMC_SEC_CAP_DYNAMIC_SHM		BIT(2)
+
+/* Secure world supports Shared Memory with a NULL buffer reference */
+#define OPTEE2_SMC_SEC_CAP_MEMREF_NULL		BIT(4)
+
+#define OPTEE2_SMC_FUNCID_EXCHANGE_CAPABILITIES	9
+#define OPTEE2_SMC_EXCHANGE_CAPABILITIES \
+	OPTEE2_SMC_FAST_CALL_VAL(OPTEE2_SMC_FUNCID_EXCHANGE_CAPABILITIES)
+
+struct optee2_smc_exchange_capabilities_result {
+	unsigned long status;
+	unsigned long capabilities;
+	unsigned long reserved0;
+	unsigned long reserved1;
+};
+
+/*
+ * Disable and empties cache of shared memory objects
+ *
+ * Secure world can cache frequently used shared memory objects, for
+ * example objects used as RPC arguments. When secure world is idle this
+ * function returns one shared memory reference to free. To disable the
+ * cache and free all cached objects this function has to be called until
+ * it returns OPTEE2_SMC_RETURN_ENOTAVAIL.
+ *
+ * Call register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_DISABLE_SHM_CACHE
+ * a1-6	Not used
+ * a7	Hypervisor Client ID register
+ *
+ * Normal return register usage:
+ * a0	OPTEE2_SMC_RETURN_OK
+ * a1	Upper 32bit of a 64bit Shared memory cookie
+ * a2	Lower 32bit of a 64bit Shared memory cookie
+ * a3-7	Preserved
+ *
+ * Cache empty return register usage:
+ * a0	OPTEE2_SMC_RETURN_ENOTAVAIL
+ * a1-7	Preserved
+ *
+ * Not idle return register usage:
+ * a0	OPTEE2_SMC_RETURN_EBUSY
+ * a1-7	Preserved
+ */
+#define OPTEE2_SMC_FUNCID_DISABLE_SHM_CACHE	10
+#define OPTEE2_SMC_DISABLE_SHM_CACHE \
+	OPTEE2_SMC_FAST_CALL_VAL(OPTEE2_SMC_FUNCID_DISABLE_SHM_CACHE)
+
+struct optee2_smc_disable_shm_cache_result {
+	unsigned long status;
+	unsigned long shm_upper32;
+	unsigned long shm_lower32;
+	unsigned long reserved0;
+};
+
+/*
+ * Enable cache of shared memory objects
+ *
+ * Secure world can cache frequently used shared memory objects, for
+ * example objects used as RPC arguments. When secure world is idle this
+ * function returns OPTEE2_SMC_RETURN_OK and the cache is enabled. If
+ * secure world isn't idle OPTEE2_SMC_RETURN_EBUSY is returned.
+ *
+ * Call register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_ENABLE_SHM_CACHE
+ * a1-6	Not used
+ * a7	Hypervisor Client ID register
+ *
+ * Normal return register usage:
+ * a0	OPTEE2_SMC_RETURN_OK
+ * a1-7	Preserved
+ *
+ * Not idle return register usage:
+ * a0	OPTEE2_SMC_RETURN_EBUSY
+ * a1-7	Preserved
+ */
+#define OPTEE2_SMC_FUNCID_ENABLE_SHM_CACHE	11
+#define OPTEE2_SMC_ENABLE_SHM_CACHE \
+	OPTEE2_SMC_FAST_CALL_VAL(OPTEE2_SMC_FUNCID_ENABLE_SHM_CACHE)
+
+/*
+ * Resume from RPC (for example after processing a foreign interrupt)
+ *
+ * Call register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_CALL_RETURN_FROM_RPC
+ * a1-3	Value of a1-3 when OPTEE2_SMC_CALL_WITH_ARG returned
+ *	OPTEE2_SMC_RETURN_RPC in a0
+ *
+ * Return register usage is the same as for OPTEE2_SMC_*CALL_WITH_ARG above.
+ *
+ * Possible return values
+ * OPTEE2_SMC_RETURN_UNKNOWN_FUNCTION	Trusted OS does not recognize this
+ *					function.
+ * OPTEE2_SMC_RETURN_OK			Original call completed, result
+ *					updated in the previously supplied.
+ *					struct optee2_msg_arg
+ * OPTEE2_SMC_RETURN_RPC			Call suspended by RPC call to normal
+ *					world.
+ * OPTEE2_SMC_RETURN_ERESUME		Resume failed, the opaque resume
+ *					information was corrupt.
+ */
+#define OPTEE2_SMC_FUNCID_RETURN_FROM_RPC	3
+#define OPTEE2_SMC_CALL_RETURN_FROM_RPC \
+	OPTEE2_SMC_STD_CALL_VAL(OPTEE2_SMC_FUNCID_RETURN_FROM_RPC)
+
+#define OPTEE2_SMC_RETURN_RPC_PREFIX_MASK	0xFFFF0000
+#define OPTEE2_SMC_RETURN_RPC_PREFIX		0xFFFF0000
+#define OPTEE2_SMC_RETURN_RPC_FUNC_MASK		0x0000FFFF
+
+#define OPTEE2_SMC_RETURN_GET_RPC_FUNC(ret) \
+	((ret) & OPTEE2_SMC_RETURN_RPC_FUNC_MASK)
+
+#define OPTEE2_SMC_RPC_VAL(func)		((func) | OPTEE2_SMC_RETURN_RPC_PREFIX)
+
+/*
+ * Allocate memory for RPC parameter passing. The memory is used to hold a
+ * struct optee2_msg_arg.
+ *
+ * "Call" register usage:
+ * a0	This value, OPTEE2_SMC_RETURN_RPC_ALLOC
+ * a1	Size in bytes of required argument memory
+ * a2	Not used
+ * a3	Resume information, must be preserved
+ * a4-5	Not used
+ * a6-7	Resume information, must be preserved
+ *
+ * "Return" register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_CALL_RETURN_FROM_RPC.
+ * a1	Upper 32bits of 64bit physical pointer to allocated
+ *	memory, (a1 == 0 && a2 == 0) if size was 0 or if memory can't
+ *	be allocated.
+ * a2	Lower 32bits of 64bit physical pointer to allocated
+ *	memory, (a1 == 0 && a2 == 0) if size was 0 or if memory can't
+ *	be allocated
+ * a3	Preserved
+ * a4	Upper 32bits of 64bit Shared memory cookie used when freeing
+ *	the memory or doing an RPC
+ * a5	Lower 32bits of 64bit Shared memory cookie used when freeing
+ *	the memory or doing an RPC
+ * a6-7	Preserved
+ */
+#define OPTEE2_SMC_RPC_FUNC_ALLOC	0
+#define OPTEE2_SMC_RETURN_RPC_ALLOC \
+	OPTEE2_SMC_RPC_VAL(OPTEE2_SMC_RPC_FUNC_ALLOC)
+
+/*
+ * Free memory previously allocated by OPTEE2_SMC_RETURN_RPC_ALLOC
+ *
+ * "Call" register usage:
+ * a0	This value, OPTEE2_SMC_RETURN_RPC_FREE
+ * a1	Upper 32bits of 64bit shared memory cookie belonging to this
+ *	argument memory
+ * a2	Lower 32bits of 64bit shared memory cookie belonging to this
+ *	argument memory
+ * a3-7	Resume information, must be preserved
+ *
+ * "Return" register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_CALL_RETURN_FROM_RPC.
+ * a1-2	Not used
+ * a3-7	Preserved
+ */
+#define OPTEE2_SMC_RPC_FUNC_FREE		2
+#define OPTEE2_SMC_RETURN_RPC_FREE \
+	OPTEE2_SMC_RPC_VAL(OPTEE2_SMC_RPC_FUNC_FREE)
+
+/*
+ * Deliver foreign interrupt to normal world.
+ *
+ * "Call" register usage:
+ * a0	OPTEE2_SMC_RETURN_RPC_FOREIGN_INTR
+ * a1-7	Resume information, must be preserved
+ *
+ * "Return" register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_CALL_RETURN_FROM_RPC.
+ * a1-7	Preserved
+ */
+#define OPTEE2_SMC_RPC_FUNC_FOREIGN_INTR		4
+#define OPTEE2_SMC_RETURN_RPC_FOREIGN_INTR \
+	OPTEE2_SMC_RPC_VAL(OPTEE2_SMC_RPC_FUNC_FOREIGN_INTR)
+
+/*
+ * Do an RPC request. The supplied struct optee2_msg_arg tells which
+ * request to do and the parameters for the request. The following fields
+ * are used (the rest are unused):
+ * - cmd		the Request ID
+ * - ret		return value of the request, filled in by normal world
+ * - num_params		number of parameters for the request
+ * - params		the parameters
+ * - param_attrs	attributes of the parameters
+ *
+ * "Call" register usage:
+ * a0	OPTEE2_SMC_RETURN_RPC_CMD
+ * a1	Upper 32bit of a 64bit Shared memory cookie holding a
+ *	struct optee2_msg_arg, must be preserved, only the data should
+ *	be updated
+ * a2	Lower 32bit of a 64bit Shared memory cookie holding a
+ *	struct optee2_msg_arg, must be preserved, only the data should
+ *	be updated
+ * a3-7	Resume information, must be preserved
+ *
+ * "Return" register usage:
+ * a0	SMC Function ID, OPTEE2_SMC_CALL_RETURN_FROM_RPC.
+ * a1-2	Not used
+ * a3-7	Preserved
+ */
+#define OPTEE2_SMC_RPC_FUNC_CMD		5
+#define OPTEE2_SMC_RETURN_RPC_CMD \
+	OPTEE2_SMC_RPC_VAL(OPTEE2_SMC_RPC_FUNC_CMD)
+
+/* Returned in a0 */
+#define OPTEE2_SMC_RETURN_UNKNOWN_FUNCTION 0xFFFFFFFF
+
+/* Returned in a0 only from Trusted OS functions */
+#define OPTEE2_SMC_RETURN_OK		0x0
+#define OPTEE2_SMC_RETURN_ETHREAD_LIMIT	0x1
+#define OPTEE2_SMC_RETURN_EBUSY		0x2
+#define OPTEE2_SMC_RETURN_ERESUME	0x3
+#define OPTEE2_SMC_RETURN_EBADADDR	0x4
+#define OPTEE2_SMC_RETURN_EBADCMD	0x5
+#define OPTEE2_SMC_RETURN_ENOMEM		0x6
+#define OPTEE2_SMC_RETURN_ENOTAVAIL	0x7
+#define OPTEE2_SMC_RETURN_IS_RPC(ret)	__optee2_smc_return_is_rpc((ret))
+
+static inline bool __optee2_smc_return_is_rpc(u32 ret)
+{
+	return ret != OPTEE2_SMC_RETURN_UNKNOWN_FUNCTION &&
+	       (ret & OPTEE2_SMC_RETURN_RPC_PREFIX_MASK) ==
+			OPTEE2_SMC_RETURN_RPC_PREFIX;
+}
+
+#endif /* OPTEE2_SMC_H */
